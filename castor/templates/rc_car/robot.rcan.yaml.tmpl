rcan_version: '3.0'
metadata:
  robot_name: {name}
  robot_uuid: {uuid}
  author: craigm26
  license: MIT
  manufacturer: {name}
  model: rc-car
  version: v1
  rrn: {rrn}
agent:
  provider: ollama
  model: qwen3.5:2b
physics:
  type: ackermann
  dof: 2
# The robot-md-gateway's rc-car actuator owns the drive layer — the deadman
# thread and the envelope budget live in THAT process. The castor runtime must
# never open a second path to the wheels, so its own driver is the mock. When
# the runtime needs the car stopped it asks the gateway, through the same signed
# /v1/invoke every other command goes through.
drivers:
  - protocol: simulation
    backend: mock
fleet:
  # Peers this robot will relay to through /api/fleet/{ruri}/command and
  # /api/fleet/{ruri}/status. EMPTY on purpose, and the emptiness is the
  # security property: an mDNS answer says where a RURI is, never that this
  # robot may talk to it, so the proxy intersects what discovery found with
  # what is listed here and 404s anything undeclared. Add a peer by its RURI
  # (a bare string, or a mapping with `ruri`/`rrn` and `url`). The caller
  # still supplies that peer's OWN token per request; this robot never lends
  # its own.
  peers: []
network:
  telemetry_stream: true
safety:
  estop_enabled: true
# The on-device sensor monitor the generated runtime constructs at startup.
# CONSERVATIVE ON PURPOSE, and these numbers are not the library's. Three
# consecutive critical readings latch an e-stop whose source is 'sensor', and a
# sensor latch is deliberately not clearable over the network: lifting it means
# `castor resume --clear-estop` standing at the robot. So a threshold a
# BENCHMARK can cross is not a safety feature, it is a ten-minute failure that
# looks like broken hardware.
#
#   cpu_temp   the honest trigger on a Pi. 90 C is ABOVE the board's own hard
#              throttle (85 C), so reaching it sustained means thermal control
#              has already failed, not that the robot is working hard.
#   disk       the other honest one. A full disk breaks the audit log first.
#   memory     99 is where the OOM killer is already acting. A benchmark that
#              legitimately uses 95 percent of a Pi must not stop the robot.
#   load       critical is load_warn_multiplier x 2 x CPU count, so 16 x 4 = 64
#              on a four-core Pi: a number a busy benchmark cannot reach and a
#              runaway fork bomb can.
#
# Raise or lower them here. This block is what the runtime reads; deleting it
# falls back to the library defaults, which are tighter than a benchmark likes.
monitor:
  interval: 5.0
  consecutive_critical: 3
  thresholds:
    cpu_temp_warn: 80.0
    cpu_temp_critical: 90.0
    memory_warn: 95.0
    memory_critical: 99.0
    disk_warn: 90.0
    disk_critical: 97.0
    load_warn_multiplier: 16.0
    force_warn_n: 40.0
    force_max_n: 50.0
# Investigator access (RCAN AUTHORITY_ACCESS, message type 41). Empty on purpose:
# with no ids listed the runtime refuses every authority request and says so in
# its log, which is the shipped state. To let a registered authority read this
# robot's records, list its registry ids here. Nothing else turns the handler on.
authority:
  trusted_authority_ids: []
rcan_protocol:
  port: {port_runtime}
  # On. It was off for a concrete reason, now fixed: castor advertised the
  # RUNTIME port on a service type the app does not browse, with a TXT record
  # carrying no rrn and no manifest_path, so a Bonjour-found robot could never
  # invoke and the flag only added noise. The record now carries the gateway
  # port, the console port, the rrn and the manifest path, on
  # _opencastor._tcp — the type the app browses.
  #
  # This is the RUNTIME's copy of that record, and it is the redundant one:
  # {name}-discovery.service publishes the same thing from its own process, so
  # a robot stays findable even when the runtime is down. Prove either with
  # `castor discovery check`. Pairing is still the QR; this record carries no
  # credential and only answers "where is this RRN now?".
  enable_mdns: true
  capabilities:
    - drive.set
    - drive.stop
    - drive.envelope.open
    - drive.envelope.revoke
    - status.report
firmware_hash: null
attestation_ref: null
fria_ref: null
