#!/usr/bin/env python3
"""Rover's castor runtime: the phone-facing surface of a robot whose wheels
live in another process.

This is the OpenCastor runtime (`castor.api:app`, opencastor 3.0.2) with exactly
two routes replaced and one always-on safety guard added. Everything else —
/health, the 401 on an unauthenticated /api/health/detail that makes the app's
"Secured" badge light up, the auth layers, uptime and identity reporting — is
the stock runtime, unmodified.

WHY A SAFETY GUARD IS STARTED HERE AND NOT IN castor/main.py. The unit `castor
up` writes runs THIS FILE. Everything main.py starts — the sensor monitor's
automatic e-stop after three consecutive critical readings, wire_safety_layer,
the brain watchdog — was on a path the shipped robot never reached: the code
existed, the server never constructed it. The only periodic work this file had
lived inside the /ws/telemetry handler, so it ran only while a phone was
connected. `_lifespan_with_safety_guard` below constructs the monitor and the
watchdog at startup and runs `_hold_loop` for the life of the process, and
`_hold()` is checked before every outbound scope that is not HALT or OBSERVE.

WHAT THAT STOP IS AND IS NOT. It is a best-effort SOFTWARE hold: this runtime
stops asking for motion and asks the actuator to stop, over a network hop that
can fail, in which case every caller is told `stop_not_confirmed` rather than a
comfortable 200. It is not a hardware cut, it de-energises nothing, and nothing
in this file is safety rated.

WHY TWO ROUTES ARE REPLACED, and not more:

  POST /api/stop      The stock handler stops `state.driver`, which for Rover is
                      the mock — it would return 200 having stopped nothing. The
                      wheels are owned by the rc-car actuator inside
                      the gateway, so the runtime's stop has to travel the same
                      signed /v1/invoke path as every other command. A STOP
                      button that answers 200 without reaching the thing that
                      moves is worse than no button.

  WS /ws/telemetry    The stock frame describes a perception loop. Rover's phone
                      needs the DRIVE ENVELOPE: how many seconds of approved
                      motion are left, when the approval lapses, what ceiling it
                      carries, and who approved it. Those numbers only exist in
                      the actuator, so this frame carries them straight through,
                      under the key `envelope`, in the shape
                      DriveEnvelopeState.from(telemetry:) parses.

Nothing here is patched in the shared opencastor-runtime checkout: bob-castor
runs the same editable install and must not change underneath it. The routes are
swapped on the app object at start, in this process only.

A NOTE ON SCOPE, because it looks odd on the wire. The gateway's tier gate reads
the envelope's `scope`, which the CALLER supplies, and denies read-tier callers
any scope in {MANIPULATE, NAVIGATE, ACTUATE, EXECUTE, COMMISSION}. This process
holds the READ bearer on purpose — it must never be able to make the car move —
so a stop it sends declares `scope: HALT`. That is not a way around the gate: it
claims strictly LESS than ACTUATE and grants nothing read tier did not already
have. What actually constrains drive.stop is the operator-controlled tool/tier
binding in gateway-policy.env, which pins it at `read` precisely so that a stop
can never be refused.
"""
from __future__ import annotations

import json
import os
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path

HOME_DIR = Path(os.environ["ROBOT_HOME"])

# Must be set BEFORE castor.api is imported: it reads OPENCASTOR_API_TOKEN into a
# module-level constant at import time, and an unset one means the runtime answers
# every protected endpoint 200 to anybody — which the app would correctly show as
# "unsecured".
os.environ.setdefault("OPENCASTOR_CONFIG", str(HOME_DIR / "robot.rcan.yaml"))

GATEWAY_URL = os.environ["ROBOT_GATEWAY_URL"]
MANIFEST_PATH = os.environ.get("ROBOT_MANIFEST", str(HOME_DIR / "ROBOT.md"))
RURI = "rcan://RRN-000000000012/robot"
READ_TOKEN = os.environ.get("READ_TOKEN", "")

if not os.environ.get("OPENCASTOR_API_TOKEN"):
    raise SystemExit(
        "FATAL: OPENCASTOR_API_TOKEN is unset. The runtime would answer every "
        "protected endpoint to anybody, and the app's security probe would "
        "report this robot as UNSECURED. Refusing to start."
    )
if not READ_TOKEN:
    raise SystemExit(
        "FATAL: READ_TOKEN is unset. The runtime could not reach the gateway, so "
        "POST /api/stop would answer 200 without stopping anything. Refusing to "
        "start."
    )

from fastapi import Depends, WebSocket  # noqa: E402
from fastapi.routing import APIRoute, APIWebSocketRoute  # noqa: E402

from castor.api import (  # noqa: E402
    _build_telemetry_payload,
    _ws_auth_ok,
    app,
    state,
    verify_token,
)
from castor.safety.latch import load as load_latch  # noqa: E402
from castor.safety.monitor import (  # noqa: E402
    MonitorThresholds,
    SensorMonitor,
    wire_safety_layer,
)
from castor.watchdog import BrainWatchdog  # noqa: E402

import asyncio  # noqa: E402
import contextlib  # noqa: E402
import logging  # noqa: E402

logger = logging.getLogger("robot.runtime")

#: How often the always-on guard re-asserts a latched stop at the actuator.
#: Not a heartbeat and not a deadman: the actuator has its own. This exists
#: because the stop travels a network hop, and the one thing worse than a stop
#: that did not arrive is a stop that did not arrive quietly.
HOLD_REASSERT_S = 5.0

#: How many times a stop is retried before this process says it did not land.
STOP_ATTEMPTS = 3


# --------------------------------------------------------------------------
# Talking to the gateway
# --------------------------------------------------------------------------

#: Scopes this runtime may send while a stop or a pause is latched. HALT is the
#: stop itself; OBSERVE only reads. Everything else is refused before it leaves
#: this process, which is what "the loop checks the e-stop before every
#: actuation" means on an archetype whose wheels are in another process.
HELD_SCOPES_ALLOWED = ("HALT", "OBSERVE")


def _hold() -> str:
    """"" when this robot may act, else one line saying why it may not.

    THE FILE FIRST, then the in-memory flag. `castor pause`, `castor resume`
    and the CLI's e-stop clear all run in a DIFFERENT PROCESS from this one, so
    a runtime that trusted only its own flag would keep holding a stop the
    operator cleared thirty seconds ago with no way to see why. resync_from_latch
    reconciles the flag in both directions and audits the change. The flag is
    still consulted afterwards, as the backstop for a stop this process latched
    but could not write to disk.
    """
    try:
        if state.fs is not None:
            state.fs.safety.resync_from_latch()
    except Exception:  # noqa: BLE001
        pass
    try:
        latch = load_latch()
        if latch.held:
            return latch.describe()
    except Exception:  # noqa: BLE001 - an unreadable latch must not wedge the robot
        pass
    try:
        if state.fs is not None and state.fs.is_estopped:
            return (f"e-stop latched (source="
                    f"{getattr(state.fs, 'estop_source', '') or 'unknown'})")
    except Exception:  # noqa: BLE001
        pass
    return ""


def _invoke(tool_name: str, scope: str, tool_args: dict | None = None,
            timeout: float = 3.0) -> tuple[int, dict]:
    """POST one RCAN INVOKE envelope. Returns (status, body).

    Never raises: the caller is either a stop path or a telemetry frame, and
    neither may die because the gateway was slow.

    REFUSES BEFORE IT SENDS when a stop or a pause is latched, unless the scope
    is HALT or OBSERVE. The gateway does not know about this robot's latch, so
    if this check is not here the latch is a note in a file that stops nothing.
    """
    held = _hold()
    if held and scope.upper() not in HELD_SCOPES_ALLOWED:
        logger.warning("refusing %s (scope=%s): %s", tool_name, scope, held)
        return 423, {"error": "held", "detail": held, "tool_name": tool_name}
    envelope = {
        "msg_id": f"runtime-{uuid.uuid4().hex[:12]}",
        "type": "rcan/v1/invoke",
        "ruri": f"rcan://RRN-000000000012/{tool_name}",
        "scope": scope,
        "tool_name": tool_name,
        "tool_args": tool_args or {},
        "manifest_path": MANIFEST_PATH,
        "nonce": uuid.uuid4().hex,
        "timestamp_ms": int(time.time() * 1000),
    }
    req = urllib.request.Request(
        f"{GATEWAY_URL}/v1/invoke",
        data=json.dumps(envelope).encode(),
        headers={"Content-Type": "application/json",
                 "Authorization": f"Bearer {READ_TOKEN}"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as exc:
        try:
            return exc.code, json.loads(exc.read() or b"{}")
        except Exception:
            return exc.code, {}
    except Exception as exc:  # transport, timeout, gateway down
        return 0, {"error": f"{type(exc).__name__}: {exc}"}


class _DriveStateCache:
    """One status.report per telemetry frame at most, shared by every viewer.

    The WS pushes at 5 Hz and there may be several sockets open. Without this,
    every extra phone watching the budget drain would add its own poll to a
    gateway that is also serving the commands being watched.
    """

    TTL_S = 0.2

    def __init__(self) -> None:
        self._at = 0.0
        self._value: dict = {}
        self._lock = asyncio.Lock()

    async def get(self) -> dict:
        async with self._lock:
            if time.monotonic() - self._at < self.TTL_S:
                return self._value
            status, body = await asyncio.to_thread(
                _invoke, "status.report", "OBSERVE", {}
            )
            if status == 200:
                self._value = body.get("telemetry") or {}
            else:
                # An unreachable gateway must not be reported as a parked car.
                # `envelope: null` is what "no approval" looks like, and claiming
                # that while the truth is unknown would show a comfortable
                # number for an approval nobody can see.
                self._value = {"unreachable": True,
                               "reason": body.get("error") or f"gateway HTTP {status}"}
            self._at = time.monotonic()
            return self._value


_drive_state = _DriveStateCache()


# --------------------------------------------------------------------------
# The stop itself, and the always-on guard that keeps asserting it
# --------------------------------------------------------------------------

#: The stop tools this runtime knows how to ask for when the robot declares
#: none. Order matters only here, and only as a last resort: a drive archetype
#: answers the first, an arm answers the second (`arm.estop` is the SO-ARM101
#: actuator's stop tool). A robot that declares its own stop capability never
#: reaches this tuple.
FALLBACK_STOP_TOOLS = ("drive.stop", "arm.estop")

#: The tool that last answered a stop, remembered so the next hold cycle asks
#: the one that works first instead of walking the list again. Reset to None
#: when the remembered tool stops answering.
_stop_tool_that_answered: str | None = None


def _declared_stop_tools() -> tuple[str, ...]:
    """The stop capability this robot DECLARES, most recently confirmed first.

    WHY THIS IS NOT JUST "drive.stop". The wheels are one archetype. The same
    generated runtime in front of an arm has no drive at all: the SO-ARM101
    actuator's stop tool is `arm.estop`, and a hold that only ever asks for
    `drive.stop` on that robot gets a refusal from the gateway and reports
    `stop_not_confirmed` forever while the arm holds torque.

    The declaration is read from the config's `rcan_protocol.capabilities`,
    which is the same list ROBOT.md publishes as `capabilities:` and the same
    list the gateway allowlists. So a robot whose manifest gained `arm.estop`
    is asked for `arm.estop`, with no edit to this file. Anything ending
    `.estop` is preferred over anything ending `.stop`: on a robot that
    declares both, the e-stop is the one meant for this path.

    Falls back to FALLBACK_STOP_TOOLS when the config declares neither, which
    is the only case where this process guesses.
    """
    caps: list = []
    try:
        caps = list(((state.config or {}).get("rcan_protocol") or {}).get("capabilities") or [])
    except Exception:  # noqa: BLE001 - a malformed config must not disarm the stop
        caps = []
    estops = [c for c in caps if isinstance(c, str) and c.endswith(".estop")]
    stops = [c for c in caps if isinstance(c, str) and c.endswith(".stop")]
    declared = tuple(dict.fromkeys(estops + stops))
    if not declared:
        declared = FALLBACK_STOP_TOOLS
    if _stop_tool_that_answered in declared:
        return (_stop_tool_that_answered,) + tuple(
            t for t in declared if t != _stop_tool_that_answered
        )
    return declared


def _stop_at_actuator(reason: str = "") -> tuple[bool, dict]:
    """Ask the thing that owns the actuator to stop. Retries. Never raises.

    This is the ONLY call in this process that can make the robot stop moving:
    the wheels (or the joints) belong to an actuator inside the gateway and
    this runtime holds the READ bearer on purpose. A latch in this process that
    never reaches here is a flag, not a stop.

    WHICH TOOL IT ASKS FOR is the robot's own declared stop capability, not a
    constant: `drive.stop` on a drive, `arm.estop` on an arm. See
    :func:`_declared_stop_tools`. The tool that answered is recorded, returned
    as `stop_tool`, and asked first next time.

    THE NETWORK IS IN THE PATH, and that is a real dependency rather than a
    footnote. A stop that cannot reach the gateway does not become a stop by
    being logged. Retries STOP_ATTEMPTS times, then returns ok=False so every
    caller can report `stop_not_confirmed` instead of a comfortable success.
    Neither tool answering 2xx is still `stop_not_confirmed`.

    Best effort, in software. It asks; it does not cut power.
    """
    global _stop_tool_that_answered
    candidates = list(_declared_stop_tools())
    last: dict = {}
    for attempt in range(1, STOP_ATTEMPTS + 1):
        for tool in list(candidates):
            status, body = _invoke(tool, "HALT", {})
            if status == 200:
                if attempt > 1 or tool != candidates[0]:
                    logger.warning("%s confirmed the stop on attempt %d", tool, attempt)
                _stop_tool_that_answered = tool
                return True, {**body, "stop_tool": tool}
            last = {"gateway_status": status,
                    "stop_tool": tool,
                    "tools_tried": list(candidates),
                    "reason": body.get("detail") or body.get("error") or "no confirmation"}
            logger.error("%s attempt %d/%d did not confirm: %s",
                         tool, attempt, STOP_ATTEMPTS, last["reason"])
            if tool == _stop_tool_that_answered:
                _stop_tool_that_answered = None
            # A 4xx from the gateway means THIS ROBOT does not have that tool
            # (unknown, not allowlisted, wrong tier), which no amount of
            # retrying changes. Drop it and keep the one that might answer;
            # never drop the last candidate, or the next attempt would ask
            # nothing at all.
            if 400 <= status < 500 and len(candidates) > 1:
                candidates.remove(tool)
        if attempt < STOP_ATTEMPTS:
            time.sleep(0.4 * attempt)
    return False, last


def _latch_locally(reason: str, source: str) -> None:
    """Latch this runtime's own safety layer so it refuses its own writes.

    Separate from the actuator stop above and not a substitute for it. This is
    what makes the runtime stop ASKING; that is what makes the car stop MOVING.
    """
    if state.fs is None:
        return
    try:
        state.fs.estop(principal="monitor", source=source, reason=reason)
    except Exception:  # noqa: BLE001
        logger.warning("local safety latch failed", exc_info=True)


def _monitor_settings() -> tuple[MonitorThresholds | None, float, int]:
    """The sensor thresholds and interval, from the config's `monitor:` block.

    READ FROM THE CONFIG, exactly the way castor/main.py:1095 reads it, and for
    a reason that is the biggest regression risk in this whole file: with the
    LIBRARY defaults, three consecutive critical readings latch a `source=
    sensor` e-stop, and a sensor latch is deliberately NOT clearable over the
    network. A benchmark that pushed a fanless Pi past the library's 80 C for
    fifteen seconds would stop the robot, hold it stopped, and refuse every
    remote resume. That is a ten-minute failure manufactured by the safety
    feature, on hardware that was merely warm.

    So `castor up` writes a conservative `monitor:` block into the generated
    robot.rcan.yaml (cpu_temp and disk are the honest triggers on a Pi; load and
    memory are set where a benchmark cannot reach them) and this reads it. An
    operator who wants the library's numbers writes them in that block.

    Unknown keys are dropped with a warning rather than raised: a typo in one
    threshold must not take the whole guard down, which is what
    ``MonitorThresholds(**cfg)`` would do inside the caller's try/except.
    """
    cfg = {}
    raw = {}
    try:
        cfg = (state.config or {}).get("monitor", {}) or {}
        raw = cfg.get("thresholds", {}) or {}
    except Exception:  # noqa: BLE001
        cfg, raw = {}, {}
    known = set(getattr(MonitorThresholds, "__dataclass_fields__", {}))
    unknown = sorted(k for k in raw if k not in known)
    if unknown:
        logger.warning("monitor.thresholds: ignoring unknown key(s) %s", unknown)
    thresholds = None
    kept = {k: float(v) for k, v in raw.items() if k in known}
    if kept:
        try:
            thresholds = MonitorThresholds(**kept)
        except Exception:  # noqa: BLE001
            logger.warning("monitor.thresholds could not be applied; using defaults",
                           exc_info=True)
    try:
        interval = float(cfg.get("interval", 5.0))
    except (TypeError, ValueError):
        interval = 5.0
    try:
        consecutive = int(cfg.get("consecutive_critical", 3))
    except (TypeError, ValueError):
        consecutive = 3
    logger.info(
        "sensor monitor: interval=%.1fs, %d consecutive criticals, thresholds=%s",
        interval, consecutive, "from config" if thresholds else "library defaults",
    )
    return thresholds, interval, consecutive


def _build_safety_guard() -> tuple[SensorMonitor, BrainWatchdog]:
    """Construct the monitor and the watchdog this runtime never had.

    THE FINDING THIS ANSWERS. `castor up` renders a unit whose ExecStart is
    THIS FILE, and this file serves `castor.api:app`. Everything in
    castor/main.py — the sensor monitor's auto e-stop after three consecutive
    critical readings, wire_safety_layer, the brain watchdog — lived on a code
    path the shipped robot never started. The safety monitor existed and was
    never constructed. So it is constructed here, in the generated runtime,
    which is the file the robot actually runs.

    WHAT IS DELIBERATELY NOT HERE: the perception loop. This is a monitor and a
    watchdog, not a second brain. Porting main.py's loop into the API process
    would double every actuation path this archetype has.
    """
    thresholds, interval, consecutive = _monitor_settings()
    monitor = SensorMonitor(
        thresholds=thresholds, interval=interval, consecutive_critical=consecutive
    )

    # wire_safety_layer installs the local latch as the monitor's e-stop
    # callback. We keep it and wrap it, because a latch that does not travel to
    # the actuator stops nothing on this archetype.
    if state.fs is not None:
        wire_safety_layer(monitor, state.fs.safety)
    inner_estop = monitor._estop_callback

    def _on_critical_estop() -> None:
        if inner_estop is not None:
            try:
                inner_estop()
            except Exception:  # noqa: BLE001
                logger.warning("local estop callback failed", exc_info=True)
        else:
            _latch_locally("SensorMonitor auto-estop", "sensor")
        ok, detail = _stop_at_actuator("sensor auto-estop")
        if not ok:
            logger.critical("stop_not_confirmed after sensor auto-estop: %s", detail)

    monitor.set_estop_callback(_on_critical_estop)

    def _watchdog_stop() -> None:
        _latch_locally("BrainWatchdog: brain unresponsive", "sensor")
        ok, detail = _stop_at_actuator("watchdog")
        if not ok:
            logger.critical("stop_not_confirmed after watchdog stop: %s", detail)

    watchdog = BrainWatchdog(state.config or {}, stop_fn=_watchdog_stop)
    # CONSTRUCTED ALWAYS, ARMED ONLY ON AN EXPLICIT OPT-IN, and this is the one
    # place where shipping the watchdog naively would have been worse than not
    # shipping it. BrainWatchdog stops the robot when no brain response has
    # arrived for `timeout_s` (default 10). NOTHING IN THIS PROCESS FEEDS IT:
    # the heartbeat is called from castor/main.py's perception loop, which this
    # runtime deliberately does not run. Armed by default it would stop every
    # freshly generated robot ten seconds after boot, latch a sensor e-stop, and
    # look exactly like broken hardware — a ten-minute failure manufactured by
    # the safety feature. So it arms only when the config says
    # `watchdog: {enabled: true}` at the TOP LEVEL, which `castor up` does not
    # write, and which only makes sense for an operator running a brain loop
    # that calls `heartbeat()`. Below, the guard feeds it from observed brain
    # activity so an opted-in robot is measuring something real.
    if (state.config or {}).get("watchdog", {}).get("enabled") is not True:
        watchdog.enabled = False
        logger.info(
            "brain watchdog constructed but NOT armed: this runtime runs no brain "
            "loop, so nothing would feed it heartbeats. Set watchdog.enabled: true "
            "in robot.rcan.yaml only if something in this process does."
        )
    return monitor, watchdog


def _feed_watchdog(watchdog) -> None:
    """Heartbeat the watchdog from brain activity this process can actually see.

    `state.thought_history` grows by one every time this runtime gets a thought
    back from the brain. That is the only brain liveness signal an API runtime
    has, and it is honest: no new thought means no new brain response. An idle
    robot nobody is talking to produces none either, which is why the watchdog
    is not armed unless an operator opted in.
    """
    if watchdog is None or not getattr(watchdog, "enabled", False):
        return
    history = getattr(state, "thought_history", None)
    count = len(history) if history is not None else 0
    if count != _feed_watchdog.last:  # type: ignore[attr-defined]
        _feed_watchdog.last = count  # type: ignore[attr-defined]
        watchdog.heartbeat()


_feed_watchdog.last = -1  # type: ignore[attr-defined]


async def _hold_loop(watchdog=None) -> None:
    """Always on, client or no client.

    The only periodic work this runtime had was inside the /ws/telemetry
    handler, so it ran only while a phone was connected — which is to say it
    was absent in exactly the situation a hold matters. This task runs for the
    life of the process and re-asserts a latched stop at the actuator, so a
    car that was latched, then power-cycled, then restarted by systemd comes
    back and is TOLD to stop rather than merely remembering that it should be.
    """
    announced = False
    cycles = 0
    while True:
        try:
            _feed_watchdog(watchdog)
            held = await asyncio.to_thread(_hold)
            if held:
                if not announced:
                    logger.warning("holding: %s", held)
                    announced = True
                    cycles = 0
                # RE-ASSERTED, NOT SPAMMED. Every stop is a signed invoke with a
                # receipt, so a robot left latched overnight at one every five
                # seconds would write thousands of identical receipts and bury
                # the one that matters. Hard for the first three cycles, when a
                # stop that did not land is worth retrying, then once a minute.
                if cycles < 3 or cycles % 12 == 0:
                    ok, detail = await asyncio.to_thread(_stop_at_actuator, held)
                    if not ok:
                        logger.critical("stop_not_confirmed while holding: %s", detail)
                cycles += 1
            elif announced:
                logger.info("hold lifted; this runtime will send motion again")
                announced = False
                cycles = 0
        except asyncio.CancelledError:
            raise
        except Exception:  # noqa: BLE001 - the guard outlives its own bugs
            logger.warning("hold loop error", exc_info=True)
        await asyncio.sleep(HOLD_REASSERT_S)


# WRAPPING THE LIFESPAN, NOT @app.on_event("startup"). `castor.api` builds its
# FastAPI with `lifespan=lifespan`, and when a lifespan context is given
# Starlette runs THAT and ignores `router.on_startup` entirely — an
# `@app.on_event("startup")` handler here would be registered, would never run,
# and would leave this file looking like it started a monitor. The wiring also
# has to happen AFTER the inner lifespan, because that is what constructs
# `state.fs`.
_inner_lifespan = app.router.lifespan_context


@contextlib.asynccontextmanager
async def _lifespan_with_safety_guard(scope_app):
    async with _inner_lifespan(scope_app):
        monitor = watchdog = None
        guard_task = None
        try:
            monitor, watchdog = _build_safety_guard()
            monitor.start()
            watchdog.start()
            logger.info("safety guard online: sensor monitor + brain watchdog")
        except Exception:  # noqa: BLE001 - never refuse to serve /health
            logger.warning("safety guard could not start", exc_info=True)
        held = _hold()
        if held:
            logger.warning("starting HELD: %s", held)
            ok, detail = _stop_at_actuator(held)
            if not ok:
                logger.critical("stop_not_confirmed at startup: %s", detail)
        guard_task = asyncio.create_task(_hold_loop(watchdog))
        try:
            yield
        finally:
            if guard_task is not None:
                guard_task.cancel()
                with contextlib.suppress(Exception):
                    await guard_task
            for component in (monitor, watchdog):
                if component is not None:
                    with contextlib.suppress(Exception):
                        component.stop()


app.router.lifespan_context = _lifespan_with_safety_guard


# --------------------------------------------------------------------------
# Route surgery
# --------------------------------------------------------------------------

def _drop_routes(*paths: str) -> None:
    keep = []
    for route in app.routes:
        if isinstance(route, (APIRoute, APIWebSocketRoute)) and route.path in paths:
            continue
        keep.append(route)
    app.router.routes = keep


_drop_routes("/api/stop", "/ws/telemetry")


@app.post("/api/stop", dependencies=[Depends(verify_token)])
async def robot_stop():
    """Stop the car, for real, through the gateway that owns the wheels.

    Returns 200 whenever the actuator confirms neutral. When the gateway cannot
    be reached this reports `stopped: false` with the reason rather than a
    cheerful 200 — the operator pressed STOP and deserves to know it did not
    land.
    """
    ok, body = await asyncio.to_thread(_stop_at_actuator, "POST /api/stop")
    # The runtime's own mock driver and safety filesystem still get their stop,
    # so the stock e-stop state stays coherent with what the app sees. The
    # latch is written to disk by the safety layer, so a restart comes back
    # stopped instead of free.
    if state.driver:
        try:
            state.driver.stop()
        except Exception:
            logger.warning("mock driver stop() raised", exc_info=True)
    if state.fs:
        try:
            state.fs.estop(principal="api", source="api", reason="POST /api/stop")
        except Exception:
            logger.warning("safety-fs estop raised", exc_info=True)

    if ok:
        return {"status": "stopped", "actuator": body.get("telemetry", {}),
                "receipt": body, "hold_kind": "best_effort_software_hold"}
    return {
        "status": "stop_not_confirmed",
        "stopped": False,
        "gateway_status": body.get("gateway_status", 0),
        "reason": body.get("reason") or "gateway did not confirm",
        "latched": True,
        "hold_kind": "best_effort_software_hold",
    }


@app.websocket("/ws/telemetry")
async def robot_ws_telemetry(websocket: WebSocket, token: str = ""):
    """Stock castor telemetry plus the drive envelope, pushed every 200 ms.

    `envelope` is the actuator's own `describe()` dict, passed through untouched:
    envelope_id, approved_by, motion_budget_s, motion_spent_s,
    motion_remaining_s, window_s, window_remaining_s, max_throttle, revoked,
    usable, unusable_because. It is `null` when no approval is open, which is a
    real state and not a failure — it is what a parked, unauthorised vehicle
    looks like.

    The numbers are read from the ROBOT on every frame rather than counted down
    here. A countdown in this process would drift from the one actually being
    spent, and would keep counting after a revocation this process never heard
    about.
    """
    if not _ws_auth_ok(token):
        await websocket.close(code=1008)
        return
    await websocket.accept()

    async def _push_loop():
        while True:
            try:
                frame = await _build_telemetry_payload()
            except Exception:
                frame = {"ts": time.time(), "robot": os.environ.get("ROBOT_NAME", "robot")}
            drive = await _drive_state.get()
            frame["drive"] = drive
            frame["envelope"] = drive.get("envelope")
            # "" when free. A phone showing an envelope with seconds left on it
            # while the robot is latched would be showing an approval that
            # cannot be spent.
            frame["held"] = await asyncio.to_thread(_hold)
            try:
                await websocket.send_json(frame)
            except Exception:
                return
            await asyncio.sleep(0.2)

    async def _recv_loop():
        """A stop asked for over the socket goes to the same place as the button."""
        try:
            while True:
                data = await websocket.receive_json()
                if isinstance(data, dict) and data.get("cmd") == "stop":
                    await asyncio.to_thread(_stop_at_actuator, "ws stop")
        except Exception:
            return

    push = asyncio.create_task(_push_loop())
    recv = asyncio.create_task(_recv_loop())
    try:
        await asyncio.wait([push, recv], return_when=asyncio.FIRST_COMPLETED)
    finally:
        for t in (push, recv):
            if not t.done():
                t.cancel()


def main() -> None:
    import uvicorn

    host = os.environ.get("ROBOT_RUNTIME_HOST", "0.0.0.0")
    port = int(os.environ["ROBOT_RUNTIME_PORT"])
    uvicorn.run(app, host=host, port=port, log_level="info")


if __name__ == "__main__":
    main()
