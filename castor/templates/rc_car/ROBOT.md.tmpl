rcan_version: '3.0'
schema: https://robotmd.dev/schema/v1/robot.schema.json
metadata:
  robot_name: {name}
  manufacturer: {name}
  model: rc-car
  version: '1.0'
  device_id: {name}
  rrn: '{rrn}'
  license: Apache-2.0
  record_url: https://robotregistryfoundation.org/v2/robots/{rrn}
  tags:
