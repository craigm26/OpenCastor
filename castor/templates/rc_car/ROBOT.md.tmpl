    - rc-car
    - raspberry-pi
    - simulated-wheels
network:
  rrf_endpoint: https://robotregistryfoundation.org
  signing_alg: ml-dsa-65
  transports:
    - http
physics:
  type: ackermann
  dof: 2
  chassis:
    wheelbase_mm: 250
    track_width_mm: 170
    wheel_radius_mm: 45
  controls:
    - id: throttle
      units: unitless
      range:
        - -1.0
        - 1.0
      neutral: 0.0
      note: "Deliberately NOT metres per second. This vehicle has no speed sensor,
        so a value in m/s would be a measurement the hardware cannot make."
    - id: steering
      units: unitless
      range:
        - -1.0
        - 1.0
      neutral: 0.0
drivers:
  - id: drive
    protocol: simulation
    backend: SimulatedDrive
    # The wheels do not exist yet. SimulatedDrive records every command and moves
    # nothing; PWMDrive is present in the package but UNVERIFIED and is not
    # reachable in this deployment (no pigpio, no GPIO configured, no ESC wired).
    hardware_present: false
    pwm_backend_enabled: false
capabilities:
  - drive.set
  - drive.stop
  - drive.envelope.open
  - drive.envelope.revoke
  - status.report
capability_contracts:
  drive.envelope.open:
    args:
      motion_budget_s:
        kind: float
        required: true
      window_s:
        kind: float
        required: true
      max_throttle:
        kind: float
        required: true
      approved_by:
        kind: string
        default: ''
    returns:
      envelope_id:
        kind: string
      motion_remaining_s:
        kind: float
    preconditions:
      - kind: backend_resolved
  drive.set:
    args:
      throttle:
        kind: float
        default: 0
      steering:
        kind: float
        default: 0
      duration_s:
        kind: float
        default: 0
    returns:
      throttle:
        kind: float
      lease_s:
        kind: float
      envelope_id:
        kind: string
    preconditions:
      - kind: envelope_open
      - kind: backend_resolved
  drive.stop:
    returns:
      stopped:
        kind: bool
  drive.envelope.revoke:
    returns:
      revoked:
        kind: bool
  status.report:
    returns:
      throttle:
        kind: float
      steering:
        kind: float
      envelope:
        kind: object
safety:
  p66_enabled: true
  loa_enforcement: true
  payload_kg: 0.0
  max_throttle: 0.35
  deadman:
    lease_timeout_ms: 400
    max_lease_ms: 2000
    layers:
      - software deadman (gateway process)
    firmware_lease: false
  estop:
    hardware: false
    software: true
    response_ms: 100
  hitl_gates:
    - scope: destructive
      require_auth: true
    - scope: system
      require_auth: true
