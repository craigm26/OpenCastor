#!/usr/bin/env python3
"""{name}'s castor runtime: the phone-facing surface of a duck whose motor bus
lives on the duck's own computer.

THIS FILE IS DELIBERATELY SHORT, and the reason is the interesting part.

The rc-car archetype's runtime.py replaces two routes, because on a car the
wheels belong to the rc-car actuator inside the *gateway* process: the runtime's
own driver is a mock, so the stock POST /api/stop would answer 200 having
stopped nothing, and the stock telemetry frame describes a perception loop
rather than the drive envelope the phone needs.

Neither is true here. `state.driver` on a duck IS a real `MicroduckDriver`,
constructed by the stock runtime from OPENCASTOR_CONFIG, holding a live
connection through {name}-duckbridge to robotd. `driver.stop()` reaches the
servos. So the stock runtime is correct as written, and replacing a route to
make it look more finished would be replacing a working stop with a copy of a
working stop.

What this file does, therefore, is refuse to start in the three states where
the stock runtime would come up looking healthy and be useless:

  * OPENCASTOR_API_TOKEN unset  — every protected endpoint answers to anybody,
                                  and the app's security probe would correctly
                                  show this robot as UNSECURED.
  * the config missing          — get_driver() returns None and every command
                                  succeeds against nothing.
  * the driver in MOCK MODE     — trap 7 of the Microduck review. MicroduckDriver
                                  degrades to a mock on ANY connect failure and
                                  keeps answering: health_check() returns
                                  {"ok": True, "mode": "mock"}, move() returns
                                  success, and the duck stands there. A runtime
                                  that starts in that state is a robot that
                                  reports itself healthy while being unreachable,
                                  which is the single most expensive failure
                                  shape in this whole project.

The third check is the one worth the file. It is also why it is a WARNING and
not an exit by default: a duck that is merely switched off should not leave a
Pi in a crash-loop, and `castor doctor` and the console both need a runtime
alive to explain the problem through. Set OPENCASTOR_DUCK_REQUIRE_HARDWARE=1
to make it fatal instead — the right setting for a demo, a benchmark run, or
anything whose result would be a lie if the duck were not there.

AND ONE THING THIS FILE NOW STARTS, for the same reason the file exists at all.
The unit `castor up` writes runs THIS FILE, not castor/main.py, so everything
main.py starts — the sensor monitor's automatic e-stop after three consecutive
critical readings, wire_safety_layer, the brain watchdog — was on a path the
shipped duck never reached. The code existed and the server never constructed
it. `_lifespan_with_safety_guard` below constructs it, and `_hold_loop` runs for
the life of the process, re-asserting a latched stop at the servos whether or
not a phone is connected. The latch is persisted under ROBOT_HOME, so a duck
that stopped and was restarted comes back stopped rather than free.

It is a best-effort SOFTWARE hold: `driver.stop()` reaches the servos through
the bridge, and when the bridge cannot be reached the guard says
`stop_not_confirmed` rather than logging a success. It is not a hardware cut
and nothing here is safety rated.
"""
from __future__ import annotations

import asyncio
import contextlib
import logging
import os
import sys
from pathlib import Path

HOME_DIR = Path(os.environ["ROBOT_HOME"])

# Must be set BEFORE castor.api is imported: it reads OPENCASTOR_API_TOKEN into a
# module-level constant at import time, and an unset one means the runtime answers
# every protected endpoint 200 to anybody.
os.environ.setdefault("OPENCASTOR_CONFIG", str(HOME_DIR / "robot.rcan.yaml"))

logger = logging.getLogger("robot.runtime")

if not os.environ.get("OPENCASTOR_API_TOKEN"):
    raise SystemExit(
        "FATAL: OPENCASTOR_API_TOKEN is unset. The runtime would answer every "
        "protected endpoint to anybody, and the app's security probe would "
        "report this robot as UNSECURED. Refusing to start."
    )

CONFIG = Path(os.environ["OPENCASTOR_CONFIG"])
if not CONFIG.is_file():
    raise SystemExit(
        f"FATAL: {CONFIG} does not exist. Without it get_driver() returns None "
        "and every command this robot accepts would succeed against nothing. "
        "Re-run `castor up --archetype microduck`."
    )

from castor.api import app, state  # noqa: E402
from castor.safety.latch import load as load_latch  # noqa: E402
from castor.safety.monitor import (  # noqa: E402
    MonitorThresholds,
    SensorMonitor,
    wire_safety_layer,
)
from castor.watchdog import BrainWatchdog  # noqa: E402

#: How often the always-on guard re-asserts a latched stop at the servos.
HOLD_REASSERT_S = 5.0

#: How many times a stop is retried before this process says it did not land.
STOP_ATTEMPTS = 3


def _hold() -> str:
    """"" when this duck may act, else one line saying why it may not.

    THE FILE FIRST, then the in-memory flag. `castor pause` and `castor resume`
    run in a DIFFERENT PROCESS, so a runtime that trusted only its own flag
    would keep holding a stop the operator cleared. resync_from_latch reconciles
    the flag in both directions and audits the change; the flag is still
    consulted afterwards as the backstop for a stop that could not be written.
    """
    try:
        if state.fs is not None:
            state.fs.safety.resync_from_latch()
    except Exception:  # noqa: BLE001
        pass
    try:
        latch = load_latch()
        if latch.held:
            return latch.describe()
    except Exception:  # noqa: BLE001 - an unreadable latch must not wedge the duck
        pass
    try:
        if state.fs is not None and state.fs.is_estopped:
            return (f"e-stop latched (source="
                    f"{getattr(state.fs, 'estop_source', '') or 'unknown'})")
    except Exception:  # noqa: BLE001
        pass
    return ""


def _stop_at_actuator(reason: str = "") -> tuple[bool, dict]:
    """Stop the servos, for real, and say so honestly when it did not happen.

    Unlike the rc-car archetype, `state.driver` here IS a real MicroduckDriver
    and `driver.stop()` reaches the servos through the bridge. What it shares
    with the car is the failure mode: the bridge is a hop, the hop can be down,
    and trap 7 of the Microduck review is a driver that degrades to a mock and
    keeps answering success. So a stop is retried, and a driver that is absent
    or in mock mode is reported as `stop_not_confirmed` rather than counted.
    """
    driver = getattr(state, "driver", None)
    if driver is None:
        return False, {"reason": "no driver was constructed; nothing to stop"}
    mode = getattr(driver, "_mode", None)
    last: dict = {}
    for attempt in range(1, STOP_ATTEMPTS + 1):
        try:
            driver.stop()
            if mode is not None and mode != "hardware":
                return False, {
                    "reason": f"driver is in {mode!r} mode, not 'hardware': "
                              "stop() returned success and nothing moved"
                }
            if attempt > 1:
                logger.warning("driver.stop() succeeded on attempt %d", attempt)
            return True, {"reason": reason}
        except Exception as exc:  # noqa: BLE001
            last = {"reason": f"{type(exc).__name__}: {exc}"}
            logger.error("driver.stop() attempt %d/%d failed: %s",
                         attempt, STOP_ATTEMPTS, last["reason"])
    return False, last


def _latch_locally(reason: str, source: str) -> None:
    """Latch this runtime's own safety layer so it refuses its own motor writes."""
    if state.fs is None:
        return
    try:
        state.fs.estop(principal="monitor", source=source, reason=reason)
    except Exception:  # noqa: BLE001
        logger.warning("local safety latch failed", exc_info=True)


def _monitor_settings() -> tuple[MonitorThresholds | None, float, int]:
    """The sensor thresholds and interval, from the config's `monitor:` block.

    READ FROM THE CONFIG, exactly the way castor/main.py:1095 reads it, and for
    a reason that is the biggest regression risk in this whole file: with the
    LIBRARY defaults, three consecutive critical readings latch a `source=
    sensor` e-stop, and a sensor latch is deliberately NOT clearable over the
    network. A benchmark that pushed a fanless Pi past the library's 80 C for
    fifteen seconds would stop the duck, hold it stopped, and refuse every
    remote resume. That is a ten-minute failure manufactured by the safety
    feature, on hardware that was merely warm.

    So `castor up` writes a conservative `monitor:` block into the generated
    robot.rcan.yaml (cpu_temp and disk are the honest triggers on a Pi; load and
    memory are set where a benchmark cannot reach them) and this reads it. An
    operator who wants the library's numbers writes them in that block.

    Unknown keys are dropped with a warning rather than raised: a typo in one
    threshold must not take the whole guard down.
    """
    cfg = {}
    raw = {}
    try:
        cfg = (state.config or {}).get("monitor", {}) or {}
        raw = cfg.get("thresholds", {}) or {}
    except Exception:  # noqa: BLE001
        cfg, raw = {}, {}
    known = set(getattr(MonitorThresholds, "__dataclass_fields__", {}))
    unknown = sorted(k for k in raw if k not in known)
    if unknown:
        logger.warning("monitor.thresholds: ignoring unknown key(s) %s", unknown)
    thresholds = None
    kept = {k: float(v) for k, v in raw.items() if k in known}
    if kept:
        try:
            thresholds = MonitorThresholds(**kept)
        except Exception:  # noqa: BLE001
            logger.warning("monitor.thresholds could not be applied; using defaults",
                           exc_info=True)
    try:
        interval = float(cfg.get("interval", 5.0))
    except (TypeError, ValueError):
        interval = 5.0
    try:
        consecutive = int(cfg.get("consecutive_critical", 3))
    except (TypeError, ValueError):
        consecutive = 3
    logger.info(
        "sensor monitor: interval=%.1fs, %d consecutive criticals, thresholds=%s",
        interval, consecutive, "from config" if thresholds else "library defaults",
    )
    return thresholds, interval, consecutive


def _build_safety_guard() -> tuple[SensorMonitor, BrainWatchdog]:
    """Construct the sensor monitor and the brain watchdog, here, in the file
    the duck actually runs.

    WHAT IS DELIBERATELY NOT HERE: the perception loop. A monitor and a
    watchdog, not a second brain.
    """
    thresholds, interval, consecutive = _monitor_settings()
    monitor = SensorMonitor(
        thresholds=thresholds, interval=interval, consecutive_critical=consecutive
    )
    if state.fs is not None:
        wire_safety_layer(monitor, state.fs.safety)
    inner_estop = monitor._estop_callback

    def _on_critical_estop() -> None:
        if inner_estop is not None:
            try:
                inner_estop()
            except Exception:  # noqa: BLE001
                logger.warning("local estop callback failed", exc_info=True)
        else:
            _latch_locally("SensorMonitor auto-estop", "sensor")
        ok, detail = _stop_at_actuator("sensor auto-estop")
        if not ok:
            logger.critical("stop_not_confirmed after sensor auto-estop: %s", detail)

    monitor.set_estop_callback(_on_critical_estop)

    def _watchdog_stop() -> None:
        _latch_locally("BrainWatchdog: brain unresponsive", "sensor")
        ok, detail = _stop_at_actuator("watchdog")
        if not ok:
            logger.critical("stop_not_confirmed after watchdog stop: %s", detail)

    watchdog = BrainWatchdog(state.config or {}, stop_fn=_watchdog_stop)
    # CONSTRUCTED ALWAYS, ARMED ONLY ON AN EXPLICIT OPT-IN, and this is the one
    # place where shipping the watchdog naively would have been worse than not
    # shipping it. BrainWatchdog stops the robot when no brain response has
    # arrived for `timeout_s` (default 10). NOTHING IN THIS PROCESS FEEDS IT:
    # the heartbeat is called from castor/main.py's perception loop, which this
    # runtime deliberately does not run. Armed by default it would stop every
    # freshly generated robot ten seconds after boot, latch a sensor e-stop, and
    # look exactly like broken hardware — a ten-minute failure manufactured by
    # the safety feature. So it arms only when the config says
    # `watchdog: {enabled: true}` at the TOP LEVEL, which `castor up` does not
    # write, and which only makes sense for an operator running a brain loop
    # that calls `heartbeat()`. Below, the guard feeds it from observed brain
    # activity so an opted-in robot is measuring something real.
    if (state.config or {}).get("watchdog", {}).get("enabled") is not True:
        watchdog.enabled = False
        logger.info(
            "brain watchdog constructed but NOT armed: this runtime runs no brain "
            "loop, so nothing would feed it heartbeats. Set watchdog.enabled: true "
            "in robot.rcan.yaml only if something in this process does."
        )
    return monitor, watchdog


def _feed_watchdog(watchdog) -> None:
    """Heartbeat the watchdog from brain activity this process can actually see.

    `state.thought_history` grows by one every time this runtime gets a thought
    back from the brain. That is the only brain liveness signal an API runtime
    has, and it is honest: no new thought means no new brain response. An idle
    robot nobody is talking to produces none either, which is why the watchdog
    is not armed unless an operator opted in.
    """
    if watchdog is None or not getattr(watchdog, "enabled", False):
        return
    history = getattr(state, "thought_history", None)
    count = len(history) if history is not None else 0
    if count != _feed_watchdog.last:  # type: ignore[attr-defined]
        _feed_watchdog.last = count  # type: ignore[attr-defined]
        watchdog.heartbeat()


_feed_watchdog.last = -1  # type: ignore[attr-defined]


async def _hold_loop(watchdog=None) -> None:
    """Always on, phone or no phone: re-assert a latched stop at the servos."""
    announced = False
    cycles = 0
    while True:
        try:
            _feed_watchdog(watchdog)
            held = await asyncio.to_thread(_hold)
            if held:
                if not announced:
                    logger.warning("holding: %s", held)
                    announced = True
                    cycles = 0
                # RE-ASSERTED, NOT SPAMMED. Every stop crosses the bridge to
                # robotd, so a duck left latched overnight at one every five
                # seconds would put thousands of identical stops through a link
                # whose whole job is carrying the next real command. Hard for
                # the first three cycles, when a stop that did not land is worth
                # retrying, then once a minute.
                if cycles < 3 or cycles % 12 == 0:
                    ok, detail = await asyncio.to_thread(_stop_at_actuator, held)
                    if not ok:
                        logger.critical("stop_not_confirmed while holding: %s", detail)
                cycles += 1
            elif announced:
                logger.info("hold lifted; this runtime will move again")
                announced = False
                cycles = 0
        except asyncio.CancelledError:
            raise
        except Exception:  # noqa: BLE001 - the guard outlives its own bugs
            logger.warning("hold loop error", exc_info=True)
        await asyncio.sleep(HOLD_REASSERT_S)


def _report_link() -> None:
    """Say, once, on the record, whether the duck actually answered.

    Read off the driver rather than off our own config: the config says what we
    ASKED for, and this whole check exists because the two can differ silently.
    """
    driver = getattr(state, "driver", None)
    mode = getattr(driver, "_mode", None)
    target = getattr(driver, "_target", "<none>")
    if driver is None:
        message = ("no driver was constructed from "
                   f"{CONFIG} — this runtime can serve health and nothing else")
    elif mode == "hardware":
        logger.info("duck link: hardware, %s", target)
        return
    else:
        message = (
            f"the Microduck driver is in {mode!r} mode, not 'hardware': it could not "
            f"reach {target}. Every command will SUCCEED and nothing will move. "
            f"Check `systemctl --user status {name}-duckbridge`, then `castor duck health`."
        )
    if os.environ.get("OPENCASTOR_DUCK_REQUIRE_HARDWARE", "").strip().lower() in ("1", "true", "yes"):
        print(f"FATAL: {message}", file=sys.stderr)
        raise SystemExit(1)
    logger.warning("duck link: %s", message)


# WRAPPING THE LIFESPAN, NOT @app.on_event("startup"), and the difference is a
# silent one. `castor.api` builds its FastAPI with `lifespan=lifespan`, and when
# a lifespan context is given Starlette runs THAT and ignores `router.on_startup`
# entirely — so an `@app.on_event("startup")` handler here would be registered,
# would never run, and would leave this file looking like it checked something.
# The check has to happen inside the same context that constructed the driver,
# and after it, which is what this does.
_inner_lifespan = app.router.lifespan_context


@contextlib.asynccontextmanager
async def _lifespan_with_safety_guard(scope_app):
    async with _inner_lifespan(scope_app):
        try:
            _report_link()
        except SystemExit:
            raise
        except Exception:  # noqa: BLE001 - a reporting bug must not stop the robot
            logger.warning("duck link: could not be reported", exc_info=True)

        monitor = watchdog = None
        guard_task = None
        try:
            monitor, watchdog = _build_safety_guard()
            monitor.start()
            watchdog.start()
            logger.info("safety guard online: sensor monitor + brain watchdog")
        except Exception:  # noqa: BLE001 - never refuse to serve /health
            logger.warning("safety guard could not start", exc_info=True)
        held = _hold()
        if held:
            logger.warning("starting HELD: %s", held)
            ok, detail = _stop_at_actuator(held)
            if not ok:
                logger.critical("stop_not_confirmed at startup: %s", detail)
        guard_task = asyncio.create_task(_hold_loop(watchdog))
        try:
            yield
        finally:
            if guard_task is not None:
                guard_task.cancel()
                with contextlib.suppress(Exception):
                    await guard_task
            for component in (monitor, watchdog):
                if component is not None:
                    with contextlib.suppress(Exception):
                        component.stop()


app.router.lifespan_context = _lifespan_with_safety_guard


def main() -> None:
    import uvicorn

    host = os.environ.get("ROBOT_RUNTIME_HOST", "0.0.0.0")
    port = int(os.environ["ROBOT_RUNTIME_PORT"])
    uvicorn.run(app, host=host, port=port, log_level="info")


if __name__ == "__main__":
    main()
