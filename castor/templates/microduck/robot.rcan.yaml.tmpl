rcan_version: '3.0'
metadata:
  robot_name: {name}
  robot_uuid: {uuid}
  author: craigm26
  license: Apache-2.0
  manufacturer: Pollen Robotics
  model: Microduck
  version: v1
  rrn: {rrn}
agent:
  provider: ollama
  model: qwen3.5:2b
  # ON, and this is fix 5 of the Microduck review made a default rather than a
  # sentence. `duck_vocabulary` and `duck_perform` are registered inside a
  # block gated on agent.harness.enabled (castor/api.py), which no shipped duck
  # profile set — so the guide's claim that the duck's tools register
  # "automatically whenever a Microduck is the attached robot" was true of the
  # function and false of the product. A robot generated by `castor up` starts
  # with the tools that let a model sequence it, not only chat about it.
  harness:
    enabled: true
physics:
  type: legged
  dof: 14
drivers:
  - id: duck
    protocol: microduck
    # tcp, not ssh, and that is the whole point of the sixth unit. `ssh` makes
    # every OpenCastor process open its own `ssh -L 7788:/run/robotd.sock`,
    # which costs an ssh key, a `robot` group edit and a REBOOT before anything
    # moves, and leaves the phone with a second relay of its own. `tcp` dials
    # {name}-duckbridge, which is already holding one connection to robotd for
    # whoever asks: one deadman, one token, both clients.
    transport: tcp
    host: {bridge_host}
    port: {bridge_port}
    # The first line this driver sends on a tcp connection. Read from the file
    # rather than written here so the token is in exactly one place on disk, at
    # 0600, and a config that gets pasted into a bug report carries no secret.
    bridge_token_file: {bridge_token_file}
    socket: {duck_socket}
    max_vx: 0.2
    max_vy: 0.1
    max_vyaw: 1.0
    intent_hz: 20
    command_ttl_s: 1.5
    # FALSE, deliberately. `robot.init` torques fifteen servos on and ramps to
    # standing over about two seconds. A robot that stands up because a service
    # restarted is a robot that fell off a table because a service restarted.
    auto_init: false
connection:
  type: {connection_type}
  host: {duck_host}
  reconnect_interval_ms: 1000
  watchdog_timeout_ms: 500
network:
  telemetry_stream: true
safety:
  estop_enabled: true
  estop_on_startup: true
  max_linear_speed_mps: 0.2
  max_angular_speed_radps: 1.0
  local_safety_wins: true
  watchdog:
    timeout_s: 2
rcan_protocol:
  port: {port_runtime}
  # On, and it is the RUNTIME's copy of the record {name}-discovery.service
  # publishes from its own process, so this robot stays findable when the
  # runtime is down. Prove either with `castor discovery check`.
  #
  # NOTE, because it is the single most surprising fact about this robot: the
  # DUCK publishes no mDNS at all. Pollen's own scripts say mDNS on that image
  # is unreliable and route around it, and a stock board's hostname is
  # `radxa-zero3`, not `duck.local`. What is advertised here is THIS host, the
  # one running the gateway, the runtime, the console and the bridge. The duck
  # itself is found by address.
  enable_mdns: true
  capabilities:
    - status
    - teleop
    - chat
    - vision
firmware_hash: null
attestation_ref: null
fria_ref: null
