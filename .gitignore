__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/
.DS_Store
*.egg-info/
dist/
build/
*.rcan.yaml
!config/**/*.rcan.yaml
# Recipe configs are SHIPPED CONTENT, not a local robot's operating config.
# Without this line `*.rcan.yaml` above silently swallowed every
# community-recipes/*/config.rcan.yaml — which is why all seven recipes
# named a config file the repository did not contain, and why
# `castor hub install` printed a tick for a file it never wrote.
!community-recipes/**/*.rcan.yaml
firebase-debug.log
response.mp3
node_modules/
.idea/
.vscode/
hailort.log
*.audit.log
.opencastor-audit.log
.opencastor-commitments.jsonl
!tests/fixtures/*.rcan.yaml

# Local robot operation configs (not preset templates)
bob.rcan.yaml
alex.rcan.yaml
9.rcan.yaml
.worktrees/
config/swarm.yaml
.worktrees/
.opencastor-commitments.jsonl
