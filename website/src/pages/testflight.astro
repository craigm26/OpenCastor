---
/* =========================================================================
   /testflight  ·  a door that outlived its hallway, kept so old links work.

   HISTORY: this page was the honest TestFlight slot while the app was in
   beta. On 2026-08-17 the operator confirmed OpenCastor 1.0 is live on the
   App Store (verified via the iTunes lookup API, id 6791719005), so every
   CTA on the site now points at the store. This route stays because links
   to /testflight exist in the wild; it says the good news and points on.
   ========================================================================= */
import HomeLayout from '../layouts/HomeLayout.astro';

const appStoreUrl = 'https://apps.apple.com/us/app/opencastor/id6791719005';
---

<HomeLayout
  title="OpenCastor on the App Store"
  canonical="https://opencastor.com/testflight"
  description="OpenCastor for iOS is out of beta and on the App Store. It is the robot's face, and on a vehicle its eye."
>
  <section class="section" aria-labelledby="tf-h">
    <div class="container">
      <h1 class="chapter" id="tf-h">The beta ended the good way.</h1>
      <div class="body-copy">
        <p>
          OpenCastor for iOS is on the App Store now, version 1.0, free. This
          page used to be the TestFlight door. It kept its address so old
          links keep working.
        </p>
        <p>
          <a class="btn btn-primary" href={appStoreUrl}>Get OpenCastor on the App Store</a>
        </p>
        <p>
          It is the robot's face, and on a vehicle its eye: pairing by QR,
          driving inside signed approvals, a chat that drafts and never runs,
          and a stop that always wins.
        </p>
      </div>
    </div>
  </section>
</HomeLayout>
