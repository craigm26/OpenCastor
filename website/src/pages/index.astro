---
/* =========================================================================
   opencastor.com  ·  "Speech Score"

   Honesty rules this file is built to, and must keep passing:
     1. No em-dashes in authored copy. Verbatim machine output keeps its own
        punctuation exactly, and only inside a device frame or a mono block.
     2. Mono type means a machine wrote it. Authored prose is never mono.
     3. Never invent hex, a signature, a hash or a timestamp. Anything not
        pasted from a real bench artifact is a labeled ink bar. Rows of `x`
        characters are not allowed.
     4. No fake footage and no fake stills. Every place a real capture
        belongs ships as an empty well with a mono caption.
     5. Two accents, one job each: brass = authorized, red = stop.

   Where the real artifacts in this file came from:
     · the human sentence ................ the operator's bench sentence, saved
                                           from that chat as the drive.creep1m
                                           capability (~/rover/capabilities.json)
     · castor up step vocabulary ......... castor/up.py, _say()
     · kid rover-gw-attest-2026 .......... ~/rover/gateway-attestation.env
     · kid rover-manifest-2026 ........... ~/rover/keys/rrf/
     · brain ollama qwen3.5:2b ........... ~/rover/active-model.json
     · the receipt ....................... ~/rover/attestation-export.ndjsonl
     · the screen strings ................ the mounted screen on the RC car
     · the ESP32-C6 boot log ............. opencastor-esp32/logs/
     · the offline verifier usage ........ RobotRegistryFoundation/robot-md-gateway,
                                           scripts/verify_receipt.py
   The `sig` and `telemetry_sha256` spans of the real receipt are covered with
   ink bars on purpose: a reader cannot tell real hex from invented hex, so
   this page prints none of it.

   THE ROBOT HAS NO LINE OF DIALOGUE. Earlier drafts of the speech score gave
   it two sentences of authored prose set in the voice face, inside rows
   labelled as capture. That is the exact forgery this page exists to argue
   against, and it also contradicted its own receipt (a 4 second window three
   screens above a duration_s of 2). The robot's turns are now the plan drafted
   from the sentence, the receipt the action left, and the string its own
   screen showed. It answers in motion, which is the headline.
   ========================================================================= */
import HomeLayout from '../layouts/HomeLayout.astro';
import Well from '../components/Well.astro';

/* The human line arrives word by word at caption cadence, never
   character-by-character terminal typing. The sentence is the operator's own,
   spoken at the bench on the run that produced the receipt below. */
const said = 'Do a 1 meter creep drive'.split(' ');

/* The plan's arguments, verbatim from the tool_args of the one real receipt
   printed further down this page. Kept in one place so the hero row and the
   anatomy card can never drift apart again. */
const planLine = 'drive.set {"throttle": 0.2, "steering": 0, "duration_s": 2}';

/* Verbatim step text in the order castor/up.py prints it, with the kid names
   from the RC car bench. Host-specific values are ink bars, and so is the
   elapsed column: this page will not print a number it did not measure. The
   actuator row and the gaps row are the branch a host takes when the rc-car
   actuator package is not installed, which is what `pip install opencastor`
   alone gives you; the caption under the log says so.
   Each row is a list of parts, so the rendered cells carry no stray
   whitespace: they are set in white-space: pre. */
type Part = string | { bar: string; label: string };

const upLog: Part[][] = [
  ['detected: ', { bar: 'w20', label: 'host-specific device list, covered with an ink bar' }],
  ['archetype: rc-car'],
  [
    'identity: ',
    { bar: 'w20', label: 'robot registration number, covered with an ink bar' },
    ' (local — `castor register` upgrades it)',
  ],
  ['ROBOT.md written and signed (kid rover-manifest-2026)'],
  ['bearers: tokens generated (actuate + read)'],
  /* castor/up.py:402, the branch that reports the resolution note, with the
     note resolve_actuator() actually returns for the rc-car actuator. The
     other branch (up.py:404) prints "actuator: rc-car (simulated wheels)",
     which is what a host that already has the package prints and is a strange
     thing to read one screen after a promise of motion. This row is what the
     `pip install opencastor` above this log really produces, and the gaps row
     below it is the same run's gap count, so the two cannot disagree. */
  [
    'actuator: noop — the rc-car actuator is not installed — ' +
      '`pip install rc-car-actuator`, then rerun `castor up`',
  ],
  ['attestation: rover-gw-attest-2026'],
  ['brain: ollama qwen3.5:2b'],
  [
    'services written: rover-gateway.service, rover-castor.service, ' +
      'rover-console.service, rover-discovery.service',
  ],
  ['services started'],
  [
    'pairing QR: ',
    { bar: 'w20', label: 'robot home path, covered with an ink bar' },
    '/pair-qr.png',
  ],
  /* castor/up.py:521, and it follows from the actuator row above: an actuator
     that resolved to noop is exactly the missing-package gap castor/gaps.py
     records. "gaps: none" belongs to a host that already has the actuator
     package, and printing it under a noop actuator would be a log no run of
     `castor up` has ever produced. */
  ['gaps: 1 noted in gaps.json (missing-package)'],
];

const bodies = [
  {
    name: 'Raspberry Pi 5 RC car',
    status: 'driving today',
    part: 'Raspberry Pi 5 · PCA9685 PWM · brushed ESC and steering servo',
    clip: 'the Pi 5 RC car driving on the bench, one take, wheels in frame',
  },
  {
    /* "on the bench", not "running": the arm's wrist camera is physically
       unplugged, so nothing here can honestly claim a vision-driven pick, and
       the fact list gives the arm no status of its own to lean on. */
    name: 'SO-ARM101 arm',
    status: 'on the bench',
    part: 'SO-ARM101 six degree of freedom · Feetech STS3215 servos, six',
    clip:
      'the SO-ARM101 arm moving to a signed pose on the bench, one take. ' +
      'Shootable today: the wrist camera is unplugged, so keep it out of ' +
      'frame and do not stage a vision-driven pick.',
  },
  {
    name: 'ESP32-C6',
    status: 'groundwork',
    part: 'ESP32-C6 rev v0.2 · 16 MB flash · toward six dollar class robots',
    clip: 'the ESP32-C6 screen showing its own pairing QR',
  },
];
---

<HomeLayout
  title="OpenCastor"
  canonical="https://opencastor.com/"
  description="OpenCastor is the open source runtime that connects AI brains to robot bodies. Speak or type one sentence, a local model drafts a bounded plan, you sign it, and the wheels turn."
>
  <!-- ===================================================== 1. HERO ===== -->
  <section id="hero" aria-labelledby="hero-h">
    <div class="wrap two-col hero-cols">
      <!-- The hero stack is a flex column below 62rem, where the CSS `order`
           declarations in home.css put the install block ahead of the speech
           score: on a 390px phone the score is six rows of evidence and it
           pushed the only call to action past the fold. Nothing here is
           focusable except the CTAs, so visual order and focus order still
           agree; the score is the reward for the first scroll. -->
      <div class="hero-stack">
        <h1 class="chapter hero-h" id="hero-h">
          Talk to your robot. It answers in motion.
        </h1>
        <p class="lede hero-lede">
          OpenCastor is the open source runtime that connects AI brains to robot
          bodies. Speak or type one sentence, a local model drafts a bounded
          plan, you sign it, and the wheels turn.
        </p>

        <!-- The speech score. One pass of the loop, typeset, and every row is
             an artifact: the operator's sentence, the plan drafted from it, the
             receipt it left, the string the robot's own screen showed. The
             robot is given no line of dialogue, because it does not answer in
             words. The gutter rule at the left margin is dotted until the
             signature lands and solid brass after: a plan is inert until
             signed, stated structurally before any security copy is read. -->
        <div class="hero-score">
          <div class="score">
            <div class="score-row">
              <span class="score-slug" aria-hidden="true">you</span>
              <p class="score-turn said">
                <span class="vh">You said: </span>{
                  said.map((w, i) => (
                    <span class="seq-word" style={`--i:${i}`}>{w}{i < said.length - 1 ? ' ' : ''}</span>
                  ))
                }
              </p>
            </div>

            <div class="score-row">
              <span class="score-slug" aria-hidden="true">plan</span>
              {/* One line, no stray whitespace: this element is white-space: pre. */}
              <div class="score-turn mono seq-plan"><span class="vh">The plan drafted from it: </span>{planLine}</div>
            </div>

            <div class="score-row is-signed seq-sign">
              <span class="score-slug" aria-hidden="true">you</span>
              <p class="score-turn said"><span class="vh">You said: </span>signed</p>
            </div>

            <div class="score-row is-signed">
              <span class="score-slug" aria-hidden="true">receipt</span>
              <div class="score-turn mono seq-receipt"><span class="vh">The receipt it left: </span>{'drive.set -> ok    envelope_signature '}<span class="inkbar w12" role="img" aria-label="signature bytes, covered with an ink bar"></span></div>
            </div>

            <div class="score-row is-signed">
              <span class="score-slug" aria-hidden="true">screen</span>
              <div class="score-turn seq-screen">
                <span class="vh">And on the robot's own screen: </span>
                <span
                  class="screen score-screen"
                  role="img"
                  aria-label="Robot screen: Creeping, 2.1 metres ahead.">Creeping — 2.1 m ahead</span>
              </div>
            </div>
          </div>

          <p class="score-cap seq-cap">
            One pass of the loop, set as type. Your sentence, the plan drafted
            from it, the receipt it left, and the line its screen showed while
            it moved. The robot has no line of dialogue here because its answer
            was the motion. The bench video is the proof.
          </p>
        </div>

        <!-- ------------------------------------------------ the 3 CTAs -->
        <div class="cta-row">
          <div class="cta-install">
            <div class="install">
              <div class="install-lines">
                <pre id="install-cmd">pip install opencastor
castor up</pre>
                <button class="copy" type="button" data-copy="install-cmd">copy</button>
              </div>
            </div>
            <p class="beta" style="max-width:34ch">
              Python 3.10 to 3.13. <code>castor up</code> takes a bare host to a
              paired robot printing its pairing QR.
            </p>
          </div>

          <div>
            <a class="btn" href="https://github.com/craigm26/OpenCastor" rel="noopener">
              Read the code on GitHub
            </a>
          </div>

          <div class="cta-tf">
            <a class="btn" href="/testflight">Get the iOS app, TestFlight beta</a>
            <p class="beta">
              Public beta, and we mean beta. Builds change most weeks, some
              things are rough, and the release notes tell you which.
            </p>
          </div>
        </div>

        <p class="hairline hero-note">
          Apache 2.0. Live on the bench this week, on a real RC car.
        </p>
      </div>

      <!-- Two objects, always visible, so the fold carries evidence even
           before any footage exists. -->
      <div>
        <div class="evidence">
          <div class="evidence-card is-signed seq-sign">
            <span class="chip chip-signed">signed</span>
            <span class="meta">kid rover-gw-attest-2026</span>
          </div>
          <div class="evidence-card is-stop">
            <span class="chip chip-stop">stop</span>
            <span class="meta">partial transcript, before the sentence ends</span>
          </div>
        </div>

        <Well clip="the one-take RC car bench video: speak the sentence, sign, wheels turn. Audio on, no cuts. HIGHEST PRIORITY: the hero's argument lands with this filled." />
      </div>
    </div>
  </section>

  <!-- ============================================ 2. STOP ALWAYS WINS == -->
  <section id="stop" class="settle" aria-labelledby="stop-h">
    <div class="wrap">
      <h2 class="chapter is-stop" id="stop-h">Stop always wins.</h2>
      <div class="two-col">
        <div class="body-copy">
          <p>
            Say stop and the word goes straight to the wheels. It does not wait
            for a model to finish thinking. It does not wait for you to finish
            the sentence. Motion needs a budget, a window, and a speed cap you
            approved. If commands stop arriving, the robot stops about a second
            later. Every action leaves a receipt you can verify offline.
          </p>
          <p>
            You are not operating a machine. You are asking someone in the room
            to do one small thing, and being told what it did.
          </p>

          <!-- The page's one and only interaction. Built only from verbatim
               screen strings. Keyboard accessible, works on touch, and under
               prefers-reduced-motion it renders the stopped state on press
               with no transition. -->
          <div class="stopdemo">
            <div class="screen" role="img" aria-label="Robot screen, moving: Depth camera at 9 hertz. Creeping, 2.1 metres ahead.">
              <span>Depth camera · 9 Hz</span>
              <span class="stopdemo-line">Creeping — 2.1 m ahead</span>
            </div>
            <div class="stopdemo-state">
              <span class="chip chip-stop stopdemo-chip" aria-hidden="true">stop</span>
              <span class="meta stopdemo-latency" aria-hidden="true">
                partial transcript, before the sentence ends
              </span>
            </div>
            <button class="stopdemo-btn" type="button" aria-pressed="false">
              press and hold to stop
            </button>
            <p class="meta stopdemo-hint">hold the button, or focus it and hold space</p>
          </div>
        </div>

        <ul class="facts">
          <li>spoken stop bypasses every model in the stack</li>
          <li>human-approved budget, window, speed cap</li>
          <li>deadman stops the robot about 1 s after commands stop</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ================================== 3. A PLAN IS INERT UNTIL SIGNED -->
  <section id="plan" class="settle" aria-labelledby="plan-h">
    <div class="wrap">
      <h2 class="chapter" id="plan-h">A plan is inert until signed.</h2>
      <div class="two-col">
        <div class="body-copy">
          <p>
            Your sentence becomes a plan, and the plan is a small, boring
            object: one tool, three arguments, and the limits it has to live
            inside. It cannot move anything. It moves when a signature lands on
            it. You sign it from your phone, or a standing owner grant you wrote
            in advance signs it for you, on terms you set.
          </p>
        </div>

        <!-- Same line as the hero row, from the same constant, and the same
             arguments as the receipt three screens down. A page that argues
             receipts are checkable does not get to disagree with its own. -->
        <div class="plan">
          <div class="plan-line">{planLine}</div>
          <div class="plan-annos">
            <div class="plan-anno"><b>drive.set</b><span>the one tool this plan may call</span></div>
            <div class="plan-anno"><b>throttle</b><span>0.2, under the speed cap you approved</span></div>
            <div class="plan-anno"><b>steering</b><span>0, straight ahead</span></div>
            <div class="plan-anno"><b>duration_s</b><span>2, the window in seconds it may move inside</span></div>
            <div class="plan-anno"><b>budget</b><span>one motion, then the plan is spent</span></div>
          </div>
          <div class="plan-sig">
            <span class="chip chip-signed">envelope_signature</span>
            <p class="meta" style="margin-top:0.6rem">
              alg Ed25519 · kid rover-gw-attest-2026 · sig
              <span class="inkbar w12" role="img" aria-label="signature bytes, covered with an ink bar"></span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================== 4. ANATOMY OF A RECEIPT ===== -->
  <section id="receipt" class="settle" aria-labelledby="receipt-h">
    <div class="wrap">
      <h2 class="plain" id="receipt-h">Anatomy of a receipt.</h2>
      <div class="two-col">
        <div>
          <div class="body-copy">
            <p>
              Every action leaves one of these behind. The tool name, the
              arguments it actually ran with, the result, and an Ed25519
              signature over the whole envelope. You can check it on a laptop
              with no network, months from now. There is no account to log into
              and no server in the loop.
            </p>
          </div>

          <!-- The offline verify gesture closes the section: one command, no
               network, months later. The verifier does NOT live in the repo
               this page links to; it ships with the gateway, in a different
               org, so the invocation here is repo-qualified and includes the
               clone. Its argument line is verbatim from the Usage block of
               RobotRegistryFoundation/robot-md-gateway,
               scripts/verify_receipt.py. -->
          <p class="receipt-note">One command, no network, months later:</p>
          <div class="logwrap is-cmd" style="margin-top:0.6rem">
            <pre>git clone https://github.com/RobotRegistryFoundation/robot-md-gateway
python robot-md-gateway/scripts/verify_receipt.py --receipt r.json --pubkey gw.pub</pre>
          </div>
          <p class="receipt-note">
            The verifier lives with the gateway, not with the runtime, and that
            is the point: it is stdlib and one crypto library, it imports
            neither the runtime nor the protocol package, and a third party
            checking your robot should not have to trust either one. It also
            flips one byte and proves the signature fails, so a run that
            reports success has asserted both directions.
          </p>
        </div>

        <div>
          <div class="receipt">
            <pre>{`{
  "v": "rcan-action-trace/1",
  "rrn": "RRN-000000000012",
  "ruri": "rcan://RRN-000000000012/drive.set",
  "invoke": {
    "type": "rcan/v1/invoke",
    "tool_name": "drive.set",
    "scope": "MANIPULATE",
    "tool_args": {
      "throttle": 0.2,
      "steering": 0,
      "duration_s": 2
    }
  },
  "outcome": {
    "status": "ok",
    "duration_ms": 1,
    "started_at": "2026-08-04T01:37:57.302051+00:00",
    "ended_at":   "2026-08-04T01:37:57.303164+00:00",
    "telemetry_sha256": `}<span
                class="inkbar w26"
                role="img"
                aria-label="telemetry digest, covered with an ink bar"></span>{`,
    "envelope_signature": {
      "alg": "Ed25519",
      "kid": "rover-gw-attest-2026",
      "sig": `}<span
                class="inkbar w26"
                role="img"
                aria-label="signature bytes, covered with an ink bar"></span>{`
    }
  }
}`}</pre>
          </div>
          <p class="meta" style="margin-top:0.9rem">
            one real receipt from the RC car bench, 2026-08-04. field names,
            alg and kid verbatim. the digest and the signature are covered:
            this page prints no hex.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ 5. TEN MINUTES, ON THE CLOCK ======== -->
  <section id="ten-minutes" class="settle" aria-labelledby="ten-h">
    <div class="wrap">
      <h2 class="plain" id="ten-h">Ten minutes, on the clock.</h2>
      <!-- This line used to say "we measure it on the bench, every build",
           which the page then contradicted with a column of ink bars. The
           ledger has no timed run in it yet, so the claim is the goal and the
           instrumentation, not a measurement. -->
      <p class="hairline" style="max-width:52ch;margin:-0.75rem 0 2rem">
        It is the goal we design against, and the command times itself so the
        number is yours to check.
      </p>

      <div class="two-col narrow-left">
        <div class="body-copy">
          <p>
            Ten minutes is the goal we design against. The timed run that fills
            the column on the right is the one the flashable Pi image produces
            when it clears hardware verification, and until that capture exists
            this page prints ink bars instead of numbers. It is not a
            certification and we will not dress it up as one.
          </p>
          <p>
            One command does the work. <code>castor up</code> detects your
            hardware, writes and signs a ROBOT.md manifest, issues its tokens,
            starts the services, and prints a pairing QR. It timestamps every
            step as it goes, so you can check the arithmetic yourself.
          </p>
        </div>

        <div>
          <!-- Two source lines, because two of them produce what is below: the
               timing printf that prefixes every row, and the actuator row's own
               f-string. -->
          <p class="meta log-legend">
            castor/up.py:312 &nbsp;·&nbsp; {'print(f"  [{time.monotonic() - started:5.1f}s] {step}")'}
            <br />
            castor/up.py:402 &nbsp;·&nbsp; {'_say(f"actuator: {actuator_name} — {actuator_note}", started)'}
          </p>
          <div class="logwrap stagger">
            <dl class="log">
              {
                upLog.map((row, i) => (
                  <>
                    <dt class="log-row" style={`--i:${i}`}>{'  ['}<span class="inkbar w5" role="img" aria-label="elapsed seconds, not captured yet"></span>{'s]'}</dt>
                    <dd class="log-row" style={`--i:${i}`}>{row.map((p) => (typeof p === 'string' ? p : <span class={`inkbar ${p.bar}`} role="img" aria-label={p.label}></span>))}</dd>
                  </>
                ))
              }
            </dl>
          </div>
          <p class="meta log-note">
            step text verbatim from castor/up.py, in the order it prints, with
            the kid names from the RC car bench. the actuator row and the gap
            row are the branch a host takes when the rc-car actuator package is
            not installed, which is what `pip install opencastor` on its own
            gives you, and they belong to each other. host-specific values and
            the elapsed column are ink bars until the operator's timed capture
            lands: this page will not print a number it did not measure.
          </p>

          <div style="margin-top:2rem">
            <Well
              clip="the timer capture: bare host to pairing QR, one take, the clock visible in frame"
              size="small"
            />
          </div>
        </div>
      </div>

      <!-- The pairing QR beat: scanning the QR is the turn from host to
           robot, so it gets its own small moment. -->
      <div class="two-col" style="margin-top:3rem">
        <div class="body-copy">
          <h3 class="sub">The scan.</h3>
          <p class="lede">
            Scan that QR with the app. Your robot has a face now, and on a
            vehicle, an eye.
          </p>
        </div>
        <div>
          <Well clip="a phone scanning the printed pairing QR, then the robot's face appearing in the app" aspect="3x4" size="small" />
        </div>
      </div>

      <div style="margin-top:3rem" class="body-copy">
        <h3 class="sub">If you would rather never open a terminal.</h3>
        <p>
          There is a flashable Pi image: blank SD card to pairing QR. It is
          built and in final hardware verification now.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================= 6. LOCAL BRAINS, LONG MEMORY ======= -->
  <section id="brains" class="settle" aria-labelledby="brains-h">
    <div class="wrap">
      <h2 class="plain" id="brains-h">Local brains, long memory.</h2>
      <div class="two-col">
        <div class="body-copy">
          <p>
            The brain runs on the robot. Ollama with qwen for language,
            gemma-vision for what the camera sees, and cloud brains available
            when you want them, optional by design. The robot also keeps a long
            term memory of its own bench history, and it recalls relevantly.
          </p>
          <ul class="facts" style="margin-top:1.5rem">
            <li>brain: ollama qwen3.5:2b</li>
            <li>vision: gemma-vision, on the robot</li>
            <li>cloud brains: optional, per robot, never required</li>
          </ul>
        </div>

        <div class="score">
          <div class="score-row">
            <span class="score-slug" aria-hidden="true">you</span>
            <p class="score-turn said">
              <span class="vh">You asked: </span>why won't it move at low throttle?
            </p>
          </div>
          <div class="score-row">
            <span class="score-slug" aria-hidden="true">bob</span>
            <div class="score-turn mono"><span class="vh">The robot's recalled answer is not on this page yet: </span>operator memory transcript pending</div>
          </div>
          <p class="score-cap">
            The question is verbatim. The answer is the robot's own recalled
            memory, and it goes here once the bench transcript is captured. We
            are not going to write a plausible one.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================== 7. THE FACE, AND ON VEHICLES THE EYE ========== -->
  <section id="face" class="settle" aria-labelledby="face-h">
    <div class="wrap">
      <h2 class="plain" id="face-h">The face, and on vehicles the eye.</h2>
      <div class="two-col">
        <div class="body-copy">
          <p>
            The iOS app is the robot's face, and on a vehicle it is also its
            eye. Wake word, per robot brain assignment, and an autonomy grant
            you hand over on purpose. Autonomy is tiered by what the camera can
            actually see: with LiDAR it runs full, with sparse depth it creeps
            only, and blind it refuses and tells you why.
          </p>
          <p style="margin-top:1.5rem">
            <a class="btn" href="/testflight">Get the iOS app, TestFlight beta</a>
          </p>
          <p class="beta">
            Public beta, and we mean beta. Builds change most weeks, some things
            are rough, and the release notes tell you which.
          </p>
        </div>

        <div>
          <div
            class="screen"
            role="img"
            aria-label="Three strings from the mounted screen: Depth camera at 9 hertz. Creeping, 2.1 metres ahead. Clear, nothing in the corridor."
          >
            <span>Depth camera · 9 Hz</span>
            <span>Creeping — 2.1 m ahead</span>
            <span>clear — nothing in the corridor</span>
          </div>
          <p class="meta" style="margin-top:0.6rem">
            three strings, verbatim, from the mounted screen
          </p>

          <div class="evidence" style="margin-top:1.5rem">
            <Well
              clip="app capture: the depth-tier ladder, LiDAR full then sparse creep-only then blind refusal"
              caption="operator app capture pending"
              aspect="3x4"
            />
            <Well
              clip="app capture: the wake word waking the robot, then a signed drive"
              caption="operator app capture pending"
              aspect="3x4"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================= 8. BODIES ====== -->
  <section id="bodies" class="settle" aria-labelledby="bodies-h">
    <div class="wrap">
      <h2 class="plain" id="bodies-h">Bodies.</h2>
      <div class="body-copy">
        <p>
          Three bodies, three honest labels. A Raspberry Pi 5 RC car, driving
          today. An SO-ARM101 six degree of freedom arm, on the bench with its
          wrist camera unplugged. An ESP32-C6, groundwork toward six dollar
          class robots that show their own pairing QR on their own screen, and
          on the bench tonight it does exactly that.
        </p>
      </div>

      <div class="bodies">
        {
          bodies.map((b, i) => (
            <article class="body-card">
              <svg
                class="line-art"
                viewBox="0 0 120 56"
                width="120"
                height="56"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
                role="img"
              >
                <title>{`Line drawing of the ${b.name}`}</title>
                {i === 0 && (
                  <>
                    <path d="M14 34h92" />
                    <path d="M26 34l8-14h52l10 14" />
                    <circle cx="34" cy="42" r="8" />
                    <circle cx="88" cy="42" r="8" />
                    <path d="M52 20h20" />
                  </>
                )}
                {i === 1 && (
                  <>
                    <path d="M22 50h24" />
                    <path d="M34 50V34l26-16 20 10" />
                    <path d="M80 28l10 8" />
                    <path d="M90 30v12" />
                    <path d="M96 30v12" />
                    <circle cx="34" cy="34" r="3" />
                    <circle cx="60" cy="18" r="3" />
                  </>
                )}
                {i === 2 && (
                  <>
                    <rect x="20" y="10" width="80" height="36" />
                    <rect x="30" y="18" width="26" height="20" />
                    <path d="M34 22h6v6h-6zM46 22h6v6h-6zM34 32h6v4h-6z" />
                    <path d="M66 20h24M66 26h18M66 32h24M66 38h14" />
                  </>
                )}
              </svg>
              <h3 class="sub" style="margin:0">{b.name}</h3>
              <span class="status">{b.status}</span>
              <span class="part">{b.part}</span>
              <Well clip={b.clip} />
            </article>
          ))
        }
      </div>

      <!-- Typographic texture, not terminal chrome: five real lines from a
           real ESP32-C6 boot capture. No green on black, no blinking cursor. -->
      <div class="bootlog">
        <p class="meta" style="margin-bottom:0.8rem">
          five lines, verbatim, from an ESP32-C6 boot capture
        </p>
        <div class="scroller">
          <pre class="mono">{`  OpenCastor C6 alive
  chip model   : ESP32-C6 (rev v0.2)
  flash size   : 16777216 bytes (16 MB) physical
  i2c total    : 5 devices on the shared bus
OpenCastor C6 heartbeat #1 tag=ALPHA uptime=2s free_heap=456464`}</pre>
        </div>
        <p class="hairline" style="margin-top:1.1rem;max-width:56ch">
          That board paints its own pairing QR on its panel now, and the QR
          encodes <a href="/pair?demo=esp32c6">opencastor.com/pair?demo=esp32c6</a>.
          Scan it off the bench, or open the page and read what a real pairing
          QR carries.
        </p>
      </div>
    </div>
  </section>

