---
/**
 * HomeLayout — the shell for the three speech-score pages (/, /pair,
 * /testflight).
 *
 * It is a thin wrapper now. It used to import home.css AND NOTHING ELSE, on the
 * grounds that global.css's navy palette "fought" this page; the answer was to
 * stop fighting it. Both stylesheets load here, in this order: global.css is the
 * site's design system and home.css is only the layer of objects these pages
 * add to it (the speech score, the receipt, the plan card, the ink bars).
 *
 * The one thing this shell still has that BaseLayout does not is the script at
 * the end of the body: the section settle, the log stagger, the copy buttons and
 * the press-and-hold stop demo. Those belong to these pages, not to the site.
 */
import '../styles/global.css';
import '../styles/home.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'OpenCastor is the open source runtime that connects AI brains to robot bodies. Speak or type one sentence, a local model drafts a bounded plan, you sign it, and the wheels turn.',
  canonical,
} = Astro.props;
---

<!--
  There is no `no-js` class and no content-revealing script in the head. The old
  arrangement hid every section with `.settle { opacity: 0 }` and depended on a
  head script plus a script at the end of the body to give the content back,
  which made a decoration load-bearing. It is inverted now: the content ships
  visible, and the settle animation exists only inside the `js-anim` class that
  the script at the end of this file adds as its first act. If that script never
  runs, the page is simply still.
-->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- favicon.png, not favicon.svg: the svg in public/ is 359 KB, which is
         larger than this entire page. -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    <!-- Theme init, the same one BaseLayout runs, so a stored preference holds
         across the whole site. This is not load-bearing: with no script at all,
         global.css's tokens already follow prefers-color-scheme. -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('oc-theme');
        if (t) {
          document.documentElement.setAttribute('data-theme', t);
        } else if (!window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter stamp={true} />

    <!-- These pages' only script: the section settle, the log stagger, the
         install copy button, and the press-and-hold stop demo. Every
         transcript, log and receipt is already complete in the HTML above;
         this file only animates their arrival, and it can fail without taking
         any content with it. -->
    <script is:inline>
      (function () {
        var reduce =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* -- section settle + the castor up log stagger ------------------
           This class is what arms the animation at all: home.css only hides a
           section inside `.js-anim`. Adding it here, in the same function that
           reveals, means the hiding rule cannot outlive the revealing code. */
        document.documentElement.classList.add('js-anim');
        var targets = document.querySelectorAll('.settle, .logwrap.stagger');
        var reveal = function (el) {
          el.classList.add('seen');
        };
        if (reduce || !('IntersectionObserver' in window)) {
          targets.forEach(reveal);
        } else {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (!e.isIntersecting) return;
                reveal(e.target);
                io.unobserve(e.target);
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );
          targets.forEach(function (el) {
            io.observe(el);
          });
          /* Safety net. A settle is decoration; content must never be stuck
             invisible because a callback did not fire. */
          setTimeout(function () {
            targets.forEach(function (el) {
              var r = el.getBoundingClientRect();
              if (r.top < window.innerHeight && r.bottom > 0) reveal(el);
            });
          }, 900);
        }

        /* -- install block copy ----------------------------------------- */
        document.querySelectorAll('[data-copy]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var src = document.getElementById(btn.getAttribute('data-copy'));
            if (!src || !navigator.clipboard) return;
            navigator.clipboard.writeText(src.textContent.trim()).then(function () {
              var was = btn.textContent;
              btn.textContent = 'copied';
              setTimeout(function () {
                btn.textContent = was;
              }, 1400);
            });
          });
        });

        /* -- the stop demo: the page's one interaction ------------------- */
        var demo = document.querySelector('.stopdemo');
        var hold = demo && demo.querySelector('.stopdemo-btn');
        if (demo && hold) {
          var down = function (ev) {
            if (ev.type === 'keydown' && ev.key !== ' ' && ev.key !== 'Enter') return;
            if (ev.type === 'keydown') ev.preventDefault();
            if (ev.type === 'pointerdown') ev.preventDefault();
            demo.classList.add('is-stopped');
            hold.setAttribute('aria-pressed', 'true');
          };
          var up = function () {
            demo.classList.remove('is-stopped');
            hold.setAttribute('aria-pressed', 'false');
          };
          hold.addEventListener('pointerdown', down);
          hold.addEventListener('keydown', down);
          hold.addEventListener('pointerup', up);
          hold.addEventListener('pointercancel', up);
          hold.addEventListener('pointerleave', up);
          hold.addEventListener('keyup', up);
          hold.addEventListener('blur', up);
        }
      })();
    </script>
  </body>
</html>
