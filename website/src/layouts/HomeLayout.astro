---
/**
 * HomeLayout — the "Speech Score" shell.
 *
 * Deliberately NOT BaseLayout: BaseLayout imports global.css, whose navy /
 * Inter / gradient system fights this page. This layout imports home.css and
 * nothing else, and it makes zero third-party requests: the four woff2 files
 * are served from /fonts/.
 */
import '../styles/home.css';
import SiteHeader from '../components/SiteHeader.astro';
import { execFileSync } from 'node:child_process';
import { readFileSync } from 'node:fs';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'OpenCastor is the open source runtime that connects AI brains to robot bodies. Speak or type one sentence, a local model drafts a bounded plan, you sign it, and the wheels turn.',
  canonical,
} = Astro.props;

/* ------------------------------------------------------------------------
   Real build stamp. Every value below is read at build time from a real
   source. Nothing here is authored by hand, and there is no signature line:
   a fabricated envelope signature on a web page is exactly the artifact
   this product exists to make impossible.
   ------------------------------------------------------------------------ */

function pkgVersion(): string {
  try {
    const toml = readFileSync(new URL('../../../pyproject.toml', import.meta.url), 'utf8');
    return toml.match(/^version\s*=\s*"([^"]+)"/m)?.[1] ?? 'unknown';
  } catch {
    return 'unknown';
  }
}

function commitSha(): string {
  const fromCI = process.env.CF_PAGES_COMMIT_SHA ?? process.env.GIT_COMMIT_SHA;
  if (fromCI) return fromCI.slice(0, 7);
  try {
    return execFileSync('git', ['rev-parse', '--short=7', 'HEAD'], {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
  } catch {
    return 'unknown';
  }
}

const build = {
  version: pkgVersion(),
  commit: commitSha(),
  at: new Date().toISOString().replace(/\.\d+Z$/, 'Z'),
};
---

<!--
  No `no-js` class and no script in the head. The old arrangement hid every
  section with `.settle { opacity: 0 }` and depended on a head script plus a
  script at the end of the body to give the content back, which made a
  decoration load-bearing. It is inverted now: the content ships visible, and
  the settle animation exists only inside the `js-anim` class that the script
  at the end of this file adds as its first act. If that script never runs, the
  page is simply still.
-->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- favicon.png, not favicon.svg: the svg in public/ is 359 KB, which is
         larger than this entire page. -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/newsreader-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/newsreader-latin-wght-italic.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ibm-plex-mono-latin-400-normal.woff2"
      crossorigin
    />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-stamp mono">
          <dl>
            <dt>package</dt>
            <dd>opencastor {build.version}</dd>
            <dt>commit</dt>
            <dd>{build.commit}</dd>
            <dt>built</dt>
            <dd>{build.at}</dd>
            <dt>license</dt>
            <dd>Apache 2.0</dd>
          </dl>
        </div>
        <nav class="foot-links" aria-label="Footer">
          <a href="/docs">Docs</a>
          <a href="https://github.com/craigm26/OpenCastor" rel="noopener">GitHub</a>
          <a href="https://robotmd.dev" rel="noopener">robotmd.dev</a>
          <a href="https://rcan.dev" rel="noopener">rcan.dev</a>
          <a href="https://apps.apple.com/us/app/opencastor/id6791719005">App Store</a>
        </nav>

        <!-- The rest of this site. These routes all still return 200 and none of
             them appear in the header, so the footer is the whole of their
             navigation: nothing that used to work became unreachable. The same
             list is in BaseLayout, which is the shell those pages use. -->
        <nav class="foot-links foot-quiet" aria-label="The rest of this site">
          <a href="/changelog">Changelog</a>
          <a href="/tutorials">Tutorials</a>
          <a href="/beginners">Beginners</a>
          <a href="/hardware">Hardware</a>
          <a href="/hub">Hub</a>
          <a href="/explore">Explore configs</a>
          <a href="/blog">Blog</a>
          <a href="/about">About</a>
          <a href="/pair">Pairing QRs</a>
        </nav>
      </div>
    </footer>

    <!-- The page's only script: the section settle, the log stagger, the
         install copy button, and the press-and-hold stop demo. Every
         transcript, log and receipt is already complete in the HTML above;
         this file only animates their arrival, and it can fail without taking
         any content with it. -->
    <script is:inline>
      (function () {
        var reduce =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* -- section settle + the castor up log stagger ------------------
           This class is what arms the animation at all: home.css only hides a
           section inside `.js-anim`. Adding it here, in the same function that
           reveals, means the hiding rule cannot outlive the revealing code. */
        document.documentElement.classList.add('js-anim');
        var targets = document.querySelectorAll('.settle, .logwrap.stagger');
        var reveal = function (el) {
          el.classList.add('seen');
        };
        if (reduce || !('IntersectionObserver' in window)) {
          targets.forEach(reveal);
        } else {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (!e.isIntersecting) return;
                reveal(e.target);
                io.unobserve(e.target);
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );
          targets.forEach(function (el) {
            io.observe(el);
          });
          /* Safety net. A settle is decoration; content must never be stuck
             invisible because a callback did not fire. */
          setTimeout(function () {
            targets.forEach(function (el) {
              var r = el.getBoundingClientRect();
              if (r.top < window.innerHeight && r.bottom > 0) reveal(el);
            });
          }, 900);
        }

        /* -- install block copy ----------------------------------------- */
        document.querySelectorAll('[data-copy]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var src = document.getElementById(btn.getAttribute('data-copy'));
            if (!src || !navigator.clipboard) return;
            navigator.clipboard.writeText(src.textContent.trim()).then(function () {
              var was = btn.textContent;
              btn.textContent = 'copied';
              setTimeout(function () {
                btn.textContent = was;
              }, 1400);
            });
          });
        });

        /* -- the stop demo: the page's one interaction ------------------- */
        var demo = document.querySelector('.stopdemo');
        var hold = demo && demo.querySelector('.stopdemo-btn');
        if (demo && hold) {
          var down = function (ev) {
            if (ev.type === 'keydown' && ev.key !== ' ' && ev.key !== 'Enter') return;
            if (ev.type === 'keydown') ev.preventDefault();
            if (ev.type === 'pointerdown') ev.preventDefault();
            demo.classList.add('is-stopped');
            hold.setAttribute('aria-pressed', 'true');
          };
          var up = function () {
            demo.classList.remove('is-stopped');
            hold.setAttribute('aria-pressed', 'false');
          };
          hold.addEventListener('pointerdown', down);
          hold.addEventListener('keydown', down);
          hold.addEventListener('pointerup', up);
          hold.addEventListener('pointercancel', up);
          hold.addEventListener('pointerleave', up);
          hold.addEventListener('keyup', up);
          hold.addEventListener('blur', up);
        }
      })();
    </script>
  </body>
</html>
