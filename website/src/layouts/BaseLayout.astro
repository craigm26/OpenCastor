---
/**
 * BaseLayout — the shell for every page that is NOT the home page.
 *
 * Minimally restyled, deliberately: the docs, changelog, blog, tutorials,
 * beginners, hardware, hub, explore, about, robot and config routes keep their
 * own content and keep returning 200. What changed is only the shell:
 *
 *   1. The old five-dropdown nav is gone, replaced by the shared quiet header
 *      (one Docs door, GitHub, the App Store).
 *   2. The Google Fonts <link> is gone. The site makes zero third-party
 *      requests; global.css's stacks resolve to the visitor's system faces.
 *   3. A footer, which this shell did not have at all. Replacing the old
 *      five-dropdown nav with a three-link header left 84 pages with NO
 *      navigation to each other: the changelog, the tutorials, the beginner
 *      path, the hardware guides, the hub, the config explorer, the blog and
 *      the about page were reachable only from the home page's own footer.
 *      SiteFooter now sits at the bottom of every page that uses this shell,
 *      which is what makes the home page's claim that they all still work an
 *      honest one.
 *
 * global.css is otherwise untouched, and the footer is now the shared component
 * rather than a second copy of the same links with its own private palette.
 */
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

export interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  canonical?: string;
}

const {
  title,
  description = 'OpenCastor is the open source runtime that connects AI brains to robot bodies. Speak or type one sentence, a local model drafts a bounded plan, you sign it, and the wheels turn.',
  ogTitle,
  ogDescription,
  ogUrl,
  canonical,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {(ogTitle || title) && <meta property="og:title" content={ogTitle ?? title} />}
  {(ogDescription || description) && <meta property="og:description" content={ogDescription ?? description} />}
  {ogUrl && <meta property="og:url" content={ogUrl} />}
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="color-scheme" content="light dark" />
  {canonical && <link rel="canonical" href={canonical} />}
  <!-- favicon.png, not favicon.svg: the svg in public/ is 359 KB. -->
  <link rel="icon" type="image/png" href="/favicon.png" />

  <!-- Theme init: must run before render to prevent flash -->
  <script is:inline>
    (function(){
      var t = localStorage.getItem('oc-theme');
      if (t) { document.documentElement.setAttribute('data-theme', t); }
      else if (!window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>
</head>
<body>

<SiteHeader />

<slot />

<SiteFooter />

<script is:inline>
(function () {
  // Reveal animations. global.css sets `.reveal { opacity: 0 }`, so this has
  // to keep running or these pages render blank.
  if (!('IntersectionObserver' in window) ||
      (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
    document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('visible'); });
    return;
  }
  var ro = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach(function (el) { ro.observe(el); });
})();
</script>

</body>
</html>
