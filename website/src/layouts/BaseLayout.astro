---
/**
 * BaseLayout — the shell for every page that is NOT the home page.
 *
 * Minimally restyled, deliberately: the docs, changelog, blog, tutorials,
 * beginners, hardware, hub, explore, about, robot and config routes keep their
 * own content and keep returning 200. What changed is only the shell:
 *
 *   1. The old five-dropdown nav is gone, replaced by the shared quiet header
 *      (one Docs door, GitHub, TestFlight).
 *   2. The Google Fonts <link> is gone. The site now makes zero third-party
 *      requests, so the same self-hosted OFL faces serve these pages too.
 *   3. A footer, which this shell did not have at all. Replacing the old
 *      five-dropdown nav with a three-link header left 84 pages with NO
 *      navigation to each other: the changelog, the tutorials, the beginner
 *      path, the hardware guides, the hub, the config explorer, the blog and
 *      the about page were reachable only from the home page's own footer.
 *      The same list now sits at the bottom of every page that uses this
 *      shell, which is what makes the home page's claim that they all still
 *      work an honest one.
 *
 * global.css is otherwise untouched. The footer below carries its own scoped
 * styles and its own palette fallbacks so it does not depend on which tokens
 * global.css happens to define.
 */
import "../styles/fonts.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";

export interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  canonical?: string;
}

const {
  title,
  description = 'OpenCastor is the open source runtime that connects AI brains to robot bodies. Speak or type one sentence, a local model drafts a bounded plan, you sign it, and the wheels turn.',
  ogTitle,
  ogDescription,
  ogUrl,
  canonical,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {(ogTitle || title) && <meta property="og:title" content={ogTitle ?? title} />}
  {(ogDescription || description) && <meta property="og:description" content={ogDescription ?? description} />}
  {ogUrl && <meta property="og:url" content={ogUrl} />}
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="color-scheme" content="light dark" />
  {canonical && <link rel="canonical" href={canonical} />}
  <!-- favicon.png, not favicon.svg: the svg in public/ is 359 KB. -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preload" as="font" type="font/woff2"
        href="/fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2" crossorigin />

  <!-- Theme init: must run before render to prevent flash -->
  <script is:inline>
    (function(){
      var t = localStorage.getItem('oc-theme');
      if (t) { document.documentElement.setAttribute('data-theme', t); }
      else if (!window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>
</head>
<body>

<SiteHeader />

<slot />

<footer class="oc-foot">
  <div class="oc-foot-inner">
    <nav class="oc-foot-links" aria-label="Footer">
      <a href="/">Home</a>
      <a href="/docs">Docs</a>
      <a href="https://github.com/craigm26/OpenCastor" rel="noopener">GitHub</a>
      <a href="https://robotmd.dev" rel="noopener">robotmd.dev</a>
      <a href="https://rcan.dev" rel="noopener">rcan.dev</a>
      <a href="https://apps.apple.com/us/app/opencastor/id6791719005">App Store</a>
    </nav>

    <!-- The rest of this site. This is the whole of these pages'
         navigation to each other, so the list is complete on purpose and is
         kept identical to the one in HomeLayout. -->
    <nav class="oc-foot-links oc-foot-quiet" aria-label="The rest of this site">
      <a href="/changelog">Changelog</a>
      <a href="/tutorials">Tutorials</a>
      <a href="/beginners">Beginners</a>
      <a href="/hardware">Hardware</a>
      <a href="/hub">Hub</a>
      <a href="/explore">Explore configs</a>
      <a href="/blog">Blog</a>
      <a href="/about">About</a>
      <a href="/pair">Pairing QRs</a>
    </nav>

    <p class="oc-foot-note">Apache 2.0. The documentation lives at docs.opencastor.com.</p>
  </div>
</footer>

<style>
  .oc-foot {
    --f-bg: #edeee6;
    --f-ink: #143028;
    --f-slate: #5d6c73;
    --f-hair: rgba(20, 48, 40, 0.12);

    background: var(--f-bg);
    color: var(--f-ink);
    border-top: 1px solid var(--f-hair);
    margin-top: 4rem;
    padding: 2.5rem 0 3rem;
    font-family:
      'Atkinson Hyperlegible Next', system-ui, -apple-system, 'Segoe UI', Roboto,
      Helvetica, Arial, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .oc-foot {
      --f-bg: #0e1412;
      --f-ink: #e6e8df;
      --f-slate: #93a3a8;
      --f-hair: rgba(230, 232, 223, 0.14);
    }
  }
  :global(:root[data-theme='dark']) .oc-foot {
    --f-bg: #0e1412;
    --f-ink: #e6e8df;
    --f-slate: #93a3a8;
    --f-hair: rgba(230, 232, 223, 0.14);
  }

  .oc-foot-inner {
    width: 100%;
    max-width: 74rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }
  .oc-foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    font-size: 0.875rem;
  }
  .oc-foot-links a {
    color: var(--f-slate);
    text-decoration: none;
  }
  .oc-foot-links a:hover {
    color: var(--f-ink);
  }
  .oc-foot-quiet {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    gap: 0.3rem 1.1rem;
  }
  .oc-foot-note {
    margin: 1.5rem 0 0;
    color: var(--f-slate);
    font-size: 0.8125rem;
  }
  .oc-foot :focus-visible {
    outline: 2px solid #c0761c;
    outline-offset: 3px;
  }
</style>

<script is:inline>
(function () {
  // Reveal animations. global.css sets `.reveal { opacity: 0 }`, so this has
  // to keep running or these pages render blank.
  if (!('IntersectionObserver' in window) ||
      (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
    document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('visible'); });
    return;
  }
  var ro = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.reveal').forEach(function (el) { ro.observe(el); });
})();
</script>

</body>
</html>
