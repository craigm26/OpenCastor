---
/**
 * The one site footer. Every page gets exactly this one.
 *
 * WHY IT EXISTS: replacing the old five-dropdown nav with a three-link header
 * left 84 pages with no navigation to each other. The changelog, the tutorials,
 * the beginner path, the hardware guides, the hub, the config explorer, the blog
 * and the about page were reachable only from the home page. This footer is the
 * whole of their navigation to each other, which is what makes the home page's
 * claim that they all still work an honest one.
 *
 * WHY IT IS ONE COMPONENT: the list used to be written out twice, once in
 * BaseLayout and once in HomeLayout, with a comment in each asking the next
 * reader to keep them identical. Six pages also carried a third copy of their
 * own, so hub, beginners, hardware, about, tutorials and changelog rendered two
 * stacked footers. One component cannot drift from itself.
 *
 * The chrome is global.css's own footer: .site-footer, .footer-inner,
 * .footer-grid, .footer-col, .footer-bottom, .footer-social. Only the build
 * stamp is local, because nothing else on the site prints one.
 */
import { execFileSync } from 'node:child_process';
import { readFileSync } from 'node:fs';

export interface Props {
  /** Print the real build stamp. The home page does; the rest do not need it. */
  stamp?: boolean;
}
const { stamp = false } = Astro.props;

/* ------------------------------------------------------------------------
   Real build stamp. Every value below is read at build time from a real
   source. Nothing here is authored by hand, and there is no signature line:
   a fabricated envelope signature on a web page is exactly the artifact
   this product exists to make impossible.
   ------------------------------------------------------------------------ */

function pkgVersion(): string {
  try {
    const toml = readFileSync(new URL('../../../pyproject.toml', import.meta.url), 'utf8');
    return toml.match(/^version\s*=\s*"([^"]+)"/m)?.[1] ?? 'unknown';
  } catch {
    return 'unknown';
  }
}

function commitSha(): string {
  const fromCI = process.env.CF_PAGES_COMMIT_SHA ?? process.env.GIT_COMMIT_SHA;
  if (fromCI) return fromCI.slice(0, 7);
  try {
    return execFileSync('git', ['rev-parse', '--short=7', 'HEAD'], {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
  } catch {
    return 'unknown';
  }
}

const build = stamp
  ? {
      version: pkgVersion(),
      commit: commitSha(),
      at: new Date().toISOString().replace(/\.\d+Z$/, 'Z'),
    }
  : null;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="nav-logo">
          <img
            src="/assets/icon-64.png"
            alt=""
            class="nav-logo-img"
            width="26"
            height="26"
            aria-hidden="true"
          />
          <span class="foot-brand-text">OpenCastor</span>
        </a>
        <p>
          The open source runtime that connects AI brains to robot bodies.
          Apache 2.0.
        </p>
        {
          build && (
            <dl class="foot-stamp">
              <dt>package</dt>
              <dd>opencastor {build.version}</dd>
              <dt>commit</dt>
              <dd>{build.commit}</dd>
              <dt>built</dt>
              <dd>{build.at}</dd>
              <dt>license</dt>
              <dd>Apache 2.0</dd>
            </dl>
          )
        }
      </div>

      <div class="footer-col">
        <h4>Runtime</h4>
        <a href="/docs">Docs</a>
        <a href="https://github.com/craigm26/OpenCastor" rel="noopener">GitHub</a>
        <a href="https://github.com/craigm26/OpenCastor/issues" rel="noopener">Issues</a>
        <a href="https://pypi.org/project/opencastor/" rel="noopener">PyPI</a>
        <a href="https://apps.apple.com/us/app/opencastor/id6791719005">App Store</a>
        <a href="https://robotmd.dev" rel="noopener">robotmd.dev</a>
        <a href="https://rcan.dev" rel="noopener">rcan.dev</a>
      </div>

      <!-- The rest of this site. These routes all still return 200 and none of
           them appear in the header, so this column is the whole of their
           navigation: nothing that used to work became unreachable. -->
      <div class="footer-col">
        <h4>This site</h4>
        <a href="/">Home</a>
        <a href="/changelog">Changelog</a>
        <a href="/tutorials">Tutorials</a>
        <a href="/beginners">Beginners</a>
        <a href="/hardware">Hardware</a>
        <a href="/pair">Pairing QRs</a>
      </div>

      <div class="footer-col">
        <h4>Community</h4>
        <a href="/hub">Hub</a>
        <a href="/explore">Explore configs</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
        <a href="https://discord.gg/jMjA8B26Bq" rel="noopener">Discord</a>
        <a href="mailto:hello@opencastor.com">Contact</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        &copy; 2025-2026 Craig Merry. Apache 2.0. The documentation lives at
        docs.opencastor.com.
      </p>
      <div class="footer-social">
        <a href="https://github.com/craigm26" aria-label="GitHub" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.09.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836a9.59 9.59 0 012.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"
            /></svg
          >
        </a>
        <a href="https://twitter.com/opencastor" aria-label="Twitter / X" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            /></svg
