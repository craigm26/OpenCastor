---
/**
 * The quiet header. One Docs door, GitHub, the App Store. Nothing else.
 *
 * The five-dropdown nav it replaced is not coming back, but its LOOK is the
 * site's own and does: the brand mark, the link scale and the App Store pill
 * are global.css's `.nav-logo` / `.nav-logo-img` / `.nav-logo-text` /
 * `.btn-nav`, so this header is the site's header with fewer doors rather than
 * a different site's header.
 *
 * The one thing not borrowed is `.nav-links`: below 768px global.css turns that
 * class into a fixed drawer that only appears with `.open`, which needs a
 * hamburger to open it. Three links do not need a drawer, so the row here keeps
 * its own class and copies `.nav-links a`'s scale and hover instead. That is
 * why a phone still shows all three doors.
 */
---

<header class="oc-head">
  <div class="oc-head-inner container">
    <a class="nav-logo" href="/">
      <img
        src="/assets/icon-64.png"
        alt=""
        class="nav-logo-img"
        width="26"
        height="26"
        aria-hidden="true"
      />
      <span class="nav-logo-text">OpenCastor</span>
    </a>
    <nav class="oc-nav" aria-label="Primary">
      <a href="/docs">Docs</a>
      <a href="https://github.com/craigm26/OpenCastor" rel="noopener">GitHub</a>
      <a class="btn-nav" href="https://apps.apple.com/us/app/opencastor/id6791719005">
        App Store
      </a>
    </nav>
  </div>
</header>

<style>
  /* Sticky, glass and blurred, which is what global.css's `.site-nav` does when
     it scrolls. Every colour is a global.css token so light mode follows. */
  .oc-head {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .oc-head-inner {
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .oc-nav {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  /* .nav-links a, restated: same scale, same weight, same hover wash. */
  .oc-nav a {
    font-size: 0.8375rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 6px 11px;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .oc-nav a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
  }
  :global([data-theme='light']) .oc-nav a:hover {
    background: rgba(0, 0, 0, 0.04);
  }
  /* The App Store pill keeps global.css's .btn-nav, so it overrides the row. */
  .oc-nav a.btn-nav {
    color: var(--text);
    margin-left: 4px;
  }
  .oc-head :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (max-width: 30rem) {
    .oc-nav {
      gap: 2px;
    }
    .oc-nav a {
      padding: 6px 8px;
      font-size: 0.8125rem;
    }
  }
</style>
